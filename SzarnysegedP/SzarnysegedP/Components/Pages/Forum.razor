@page "/forum"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SzarnysegedShared.DTOs.ForumDTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject SzarnysegedP.Services.AuthService AuthService

<PageTitle>Fórum – Szárnysegéd</PageTitle>

@* ===== CSS STÍLUSOK ===== *@
<style>
    .forum-loading {
        max-width: 1100px;
        margin: 60px auto;
        padding: 0 20px;
        text-align: center;
        color: var(--brown-light);
        font-size: 15px;
    }

    .forum-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px 60px;
    }

    .forum-header {
        margin-bottom: 24px;
    }

    .forum-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(28px, 4vw, 40px);
        color: var(--text-dark);
        margin: 0 0 8px;
    }

    .forum-header p {
        margin: 0;
        color: var(--brown-light);
        font-size: 15px;
    }

    .forum-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 24px;
        align-items: start;
    }

    .forum-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .forum-main {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
    }

    .forum-card,
    .forum-post-card {
        background: var(--white);
        border: 1px solid rgba(92,74,50,0.12);
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(92,74,50,0.06);
    }

    .forum-card {
        padding: 20px;
    }

    .forum-card h3 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--text-dark);
        margin: 0 0 12px;
    }

    .forum-card p {
        color: var(--brown);
        font-size: 14px;
        line-height: 1.7;
        margin: 0;
    }

    .forum-tip-list {
        margin: 0;
        padding-left: 18px;
        color: var(--brown);
        font-size: 14px;
        line-height: 1.8;
    }

    .forum-create-card {
        padding: 22px;
    }

    .forum-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 16px;
    }

    .forum-field label {
        font-size: 12px;
        font-weight: 700;
        color: var(--brown);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .forum-field input,
    .forum-field textarea,
    .forum-field select {
        width: 100%;
        border: 1px solid rgba(92,74,50,0.18);
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 14px;
        font-family: 'Lato', 'Segoe UI', Tahoma, sans-serif;
        color: var(--text-dark);
        background: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .forum-field input:focus,
    .forum-field textarea:focus,
    .forum-field select:focus {
        outline: none;
        border-color: var(--green-mid);
        box-shadow: 0 0 0 3px rgba(45,90,61,0.12);
    }

    .forum-field textarea {
        min-height: 130px;
        resize: vertical;
        line-height: 1.7;
    }

    .forum-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .forum-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .forum-message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fff4e8;
        border: 1px solid rgba(122,110,95,0.22);
        color: var(--brown);
        font-size: 13px;
    }

    .forum-selected-tag {
        margin-bottom: 16px;
        color: var(--brown);
        font-size: 13px;
    }

    .forum-selected-tag span {
        color: var(--green-mid);
        font-weight: 700;
    }

    .forum-post-card {
        overflow: hidden;
    }

    .forum-post-top {
        padding: 16px 18px 0;
    }

    .forum-post-user {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
    }

    .forum-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--cream);
        background: var(--green-mid);
        flex-shrink: 0;
    }

    .forum-avatar-monogram {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 700;
    }

    .forum-user-meta {
        min-width: 0;
    }

    .forum-user-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .forum-user-handle {
        font-size: 12px;
        color: var(--brown-light);
    }

    .forum-post-body {
        padding: 14px 18px 16px;
    }

    .forum-post-title {
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        color: var(--text-dark);
        margin: 0 0 10px;
    }

    .forum-post-text {
        font-size: 14px;
        line-height: 1.8;
        color: var(--brown);
    }

    .forum-post-image-wrap {
        margin-top: 16px;
    }

    .forum-post-image {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
    }

    .forum-post-tags {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .forum-tag,
    .forum-inline-tag {
        color: var(--green-mid);
        font-weight: 700;
        text-decoration: none;
    }

    .forum-tag {
        display: inline-block;
        background: rgba(45,90,61,0.08);
        border: 1px solid rgba(45,90,61,0.16);
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 13px;
    }

    .forum-tag:hover,
    .forum-inline-tag:hover {
        color: var(--green-dark);
        text-decoration: underline;
    }

    .forum-post-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        border-top: 1px solid rgba(92,74,50,0.08);
        padding: 12px 18px 14px;
        flex-wrap: wrap;
    }

    .forum-footer-btn {
        background: none;
        border: none;
        color: var(--brown-light);
        font-size: 13px;
        cursor: pointer;
        padding: 0;
        transition: color 0.2s;
    }

    .forum-footer-btn:hover {
        color: var(--green-mid);
    }

    .forum-empty {
        text-align: center;
        color: var(--brown-light);
        font-size: 14px;
        padding: 20px 0;
    }

    .forum-create-launcher {
        padding: 16px 18px;
    }

    .forum-create-launcher-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .forum-create-trigger {
        flex: 1;
        background: var(--cream);
        border: 1px solid rgba(92,74,50,0.12);
        border-radius: 999px;
        padding: 12px 16px;
        text-align: left;
        color: var(--brown-light);
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }

    .forum-create-trigger:hover {
        background: #efe7db;
        border-color: rgba(92,74,50,0.22);
    }

    .forum-create-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .forum-close-btn {
        background: transparent;
        border: none;
        color: var(--brown-light);
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
        padding: 0;
    }

    .forum-close-btn:hover {
        color: var(--green-mid);
    }

    .forum-cancel-btn {
        background: transparent;
        border: 1px solid rgba(92,74,50,0.22);
        color: var(--brown);
        padding: 13px 24px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }

    .forum-cancel-btn:hover {
        background: var(--cream);
        border-color: rgba(92,74,50,0.32);
        transform: translateY(-1px);
    }

    .forum-post-upload-preview {
        margin-top: 12px;
    }

    .forum-post-upload-preview img {
        width: 100%;
        max-height: 320px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid rgba(92,74,50,0.12);
        box-shadow: 0 4px 16px rgba(92,74,50,0.08);
        display: block;
    }

    .forum-filter-card {
        margin-bottom: 18px;
    }

    /* ===== RESZPONZÍV TÖRÉSPONTOK ===== */
    @@media (max-width: 900px) {
        .forum-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .forum-grid {
            grid-template-columns: 1fr;
        }

        .forum-post-title {
            font-size: 20px;
        }

        .forum-create-launcher-row {
            flex-direction: column;
            align-items: stretch;
        }

        .forum-filter-card .forum-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .forum-filter-card .forum-actions button {
            width: 100%;
        }
    }
</style>

@* ===== HTML STRUKTÚRA ===== *@
@* Betöltési állapot *@
@if (isLoading)
{
    <div class="forum-loading">
        <p>Bejegyzések betöltése...</p>
    </div>
}
else
{
    <div class="forum-page">
        <div class="forum-header">
            <div>
                <h1>Közösségi fórum</h1>
                <p>Tapasztalatok, kérdések, helyszínek, élmények — minden egy helyen.</p>
            </div>
        </div>

        <div class="forum-layout">
            @* ===== BAL OLDALI SIDEBAR ===== *@
            <aside class="forum-sidebar">
                <div class="forum-card">
                    <h3>Fórum</h3>
                    <p>
                        Ossz meg élményeket, kérdezz más pilótáktól, és jelöld meg a repülési helyszíneket.
                    </p>
                </div>

                <div class="forum-card">
                    <h3>Tippek</h3>
                    <ul class="forum-tip-list">
                        <li>Írj beszédes címet.</li>
                        <li>Használj helyszín taget.</li>
                        <li>Légy segítőkész a kommentekben.</li>
                    </ul>
                </div>
            </aside>

            @* ===== FŐ TARTALOM ===== *@
            <section class="forum-main">
                @* ===== ÚJ BEJEGYZÉS LÉTREHOZÁS ===== *@
                @if (isLoggedIn)
                {
                    @* Ha a létrehozó panel ZÁRVA van → trigger gomb *@
                    @if (!ujBejegyzesNyitva)
                    {
                        <div class="forum-card forum-create-launcher">
                            <div class="forum-create-launcher-row">
                                <button type="button"
                                        class="forum-create-trigger"
                                        @onclick="() => ujBejegyzesNyitva = true">
                                    Új bejegyzés írása...
                                </button>
                            </div>
                        </div>
                    }

                    @* Ha a létrehozó panel NYITVA van → űrlap *@
                    @if (ujBejegyzesNyitva)
                    {
                        <div class="forum-card forum-create-card">
                            <div class="forum-create-header">
                                <h3>Új bejegyzés</h3>

                                <button type="button"
                                        class="forum-close-btn"
                                        @onclick="CloseCreatePost">
                                    ×
                                </button>
                            </div>

                            @* Visszajelzés üzenet *@
                            @if (!string.IsNullOrWhiteSpace(createMessage))
                            {
                                <div class="forum-message">@createMessage</div>
                            }

                            @* Cím mező *@
                            <div class="forum-field">
                                <label>Cím</label>
                                <input @bind="ujBejegyzes.Cim" placeholder="pl. Első repülésem Dobogókőn" />
                            </div>

                            @* Tartalom mező *@
                            <div class="forum-field">
                                <label>Tartalom</label>
                                <textarea @bind="ujBejegyzes.Tartalom"
                                          rows="5"
                                          placeholder="Írd le az élményedet, kérdésedet vagy tapasztalatodat..."></textarea>
                            </div>

                            @* Spot kiválasztó + Kép feltöltés (egymás mellett) *@
                            <div class="forum-grid">
                                <div class="forum-field">
                                    <label>Spot</label>
                                    <select @bind="selectedSpotIdString">
                                        <option value="">Nincs kiválasztva</option>
                                        @foreach (var spot in spotok)
                                        {
                                            <option value="@spot.SpotID">@spot.Nev</option>
                                        }
                                    </select>
                                </div>

                                <div class="forum-field">
                                    <label>Kép feltöltése</label>
                                    @* InputFile: Blazor beépített fájlfeltöltő *@
                                    <InputFile OnChange="UploadPostImageFile" accept=".jpg,.jpeg,.png,.webp" />

                                    @if (!string.IsNullOrWhiteSpace(postImageMessage))
                                    {
                                        <div class="forum-message" style="margin-top:10px;">@postImageMessage</div>
                                    }

                                    @* Feltöltött kép előnézete *@
                                    @if (!string.IsNullOrWhiteSpace(ujBejegyzes.KepUrl))
                                    {
                                        <div class="forum-post-upload-preview">
                                            <img src="@ujBejegyzes.KepUrl"
                                                 alt="Bejegyzés kép előnézet"
                                                 onerror="this.style.display='none'" />
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Kiválasztott spot tag megjelenítése *@
                            @if (!string.IsNullOrWhiteSpace(selectedSpotSlug))
                            {
                                <div class="forum-selected-tag">
                                    Helyszín tag: <span>#@selectedSpotSlug</span>
                                </div>
                            }

                            @* Akció gombok *@
                            <div class="forum-actions">
                                <button type="button"
                                        class="btn-primary-custom"
                                        @onclick="CreateBejegyzes"
                                        disabled="@isCreating">
                                    @(isCreating ? "Küldés..." : "Bejegyzés közzététele")
                                </button>

                                <button type="button"
                                        class="forum-cancel-btn"
                                        @onclick="CloseCreatePost">
                                    Mégse
                                </button>
                            </div>
                        </div>
                    }
                }

                @* ===== SZŰRŐ KÁRTYA ===== *@
                @* Keresés szöveg alapján + spot szűrő *@
                <div class="forum-card forum-create-card forum-filter-card">
                    <div class="forum-grid">
                        <div class="forum-field">
                            <label>Keresés</label>
                            <input placeholder="Cím, tartalom, felhasználó..." @bind="searchText" @bind:event="oninput" />
                        </div>

                        <div class="forum-field">
                            <label>Helyszín</label>
                            <select @bind="selectedFilterSpotIdString">
                                <option value="">Összes helyszín</option>
                                @foreach (var spot in spotok)
                                {
                                    <option value="@spot.SpotID">@spot.Nev</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="forum-actions">
                        <button type="button" class="forum-cancel-btn" @onclick="ClearForumFilters">
                            Szűrők törlése
                        </button>
                    </div>
                </div>

                @* ===== BEJEGYZÉSEK LISTÁJA ===== *@
                @if (filteredPosts.Count == 0)
                {
                    <div class="forum-card">
                        <p class="forum-empty">Nincs a szűrésnek megfelelő bejegyzés.</p>
                    </div>
                }
                else
                {
                    @foreach (var post in filteredPosts)
                    {
                        <article class="forum-post-card">
                            @* Felhasználó fejléc (avatar + név + dátum) *@
                            <div class="forum-post-top">
                                @* Kattintható → a felhasználó profiljára navigál *@
                                <div class="forum-post-user" @onclick="() => OpenProfil(post.FelhasznaloNev)">
                                    @if (!string.IsNullOrWhiteSpace(post.AvatarUrl))
                                    {
                                        <img class="forum-avatar"
                                             src="@post.AvatarUrl"
                                             alt="@post.FelhasznaloNev"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <div class="forum-avatar forum-avatar-monogram">
                                            @GetMonogram(post.TeljesNev, post.FelhasznaloNev)
                                        </div>
                                    }

                                    <div class="forum-user-meta">
                                        <div class="forum-user-name">
                                            @(string.IsNullOrWhiteSpace(post.TeljesNev)
                                                ? post.FelhasznaloNev
                                                : post.TeljesNev)
                                        </div>
                                        <div class="forum-user-handle">
                                            @("@"+post.FelhasznaloNev) · @FormatDatum(post.Letrehozva)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Bejegyzés tartalma *@
                            <div class="forum-post-body">
                                @if (!string.IsNullOrWhiteSpace(post.Cim))
                                {
                                    <h2 class="forum-post-title">@post.Cim</h2>
                                }

                                <div class="forum-post-text">
                                    @RenderTartalom(post)
                                </div>

                                @* Csatolt kép *@
                                @if (!string.IsNullOrWhiteSpace(post.KepUrl))
                                {
                                    <div class="forum-post-image-wrap">
                                        <img class="forum-post-image"
                                             src="@post.KepUrl"
                                             alt="@post.Cim"
                                             onerror="this.style.display='none'" />
                                    </div>
                                }

                                @* Spot tag *@
                                @if (!string.IsNullOrWhiteSpace(post.SpotSlug))
                                {
                                    <div class="forum-post-tags">
                                        <a class="forum-tag"
                                           href="@($"/terkep?spot={post.SpotSlug}")">
                                            #@post.SpotSlug
                                        </a>
                                    </div>
                                }
                            </div>

                            @* Lábléc *@
                            <div class="forum-post-footer">
                                <button type="button"
                                        class="forum-footer-btn"
                                        @onclick="() => OpenBejegyzes(post.BejegyzesID)">
                                    💬 @post.KommentekSzama komment
                                </button>

                                <button type="button"
                                        class="forum-footer-btn"
                                        @onclick="() => OpenProfil(post.FelhasznaloNev)">
                                    👤 profil
                                </button>
                            </div>
                        </article>
                    }
                }
            </section>
        </div>
    </div>
}

@code {
    // ===== ÁLLAPOTVÁLTOZÓK =====
    private bool ujBejegyzesNyitva = false;

    private List<BejegyzesListaDto> bejegyzesek = new();
    private List<SpotListaElem> spotok = new();

    private BejegyzesLetrehozasDto ujBejegyzes = new();

    private bool isLoading = true;
    private bool isCreating = false;
    private bool isLoggedIn = false;

    private string createMessage = "";
    private string selectedSpotIdString = "";
    private string postImageMessage = "";

    private string searchText = "";
    private string selectedFilterSpotIdString = "";

    // ===== COMPUTED PROPERTY-K =====
    // Ezek automatikusan újraszámolódnak, amikor a mögöttes változó megváltozik
    private int? SelectedSpotId
    {
        get
        {
            if (int.TryParse(selectedSpotIdString, out var id))
                return id;
            return null;
        }
    }

    private int? SelectedFilterSpotId
    {
        get
        {
            if (int.TryParse(selectedFilterSpotIdString, out var id))
                return id;
            return null;
        }
    }

    // A kiválasztott spot slug-ja
    private string? selectedSpotSlug
        => spotok.FirstOrDefault(x => x.SpotID == SelectedSpotId)?.Slug;

    // ===== SZŰRT BEJEGYZÉSEK =====
    private List<BejegyzesListaDto> filteredPosts =>
        bejegyzesek.Where(PostMatchesFilter).ToList();

    // ===== ÉLETCIKLUS =====
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        isLoggedIn = await AuthService.IsLoggedIn();
        await AuthService.SetAuthorizationHeader();

        await LoadSpotok();
        await LoadBejegyzesek();

        isLoading = false;
        StateHasChanged();
    }

    // ===== ADATBETÖLTÉS =====
    private async Task LoadBejegyzesek()
    {
        var result = await Http.GetFromJsonAsync<List<BejegyzesListaDto>>("api/forum/bejegyzesek");
        bejegyzesek = result ?? new List<BejegyzesListaDto>();
    }

    // Spotok lekérdezése az API-ból
    private async Task LoadSpotok()
    {
        var result = await Http.GetFromJsonAsync<List<SpotListaElem>>("api/spotok");
        spotok = result ?? new List<SpotListaElem>();

        foreach (var spot in spotok)
        {
            if (string.IsNullOrWhiteSpace(spot.Slug) && !string.IsNullOrWhiteSpace(spot.Nev))
            {
                spot.Slug = Slugify(spot.Nev);
            }
        }
    }

    // ===== SZŰRŐ LOGIKA =====
    private bool PostMatchesFilter(BejegyzesListaDto post)
    {
        var matchesText =
            string.IsNullOrWhiteSpace(searchText)
            || (post.Cim?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (post.Tartalom?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (post.FelhasznaloNev?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (post.SpotNev?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false);

        var matchesSpot =
            SelectedFilterSpotId == null
            || post.SpotID == SelectedFilterSpotId;

        return matchesText && matchesSpot;
    }

    private void ClearForumFilters()
    {
        searchText = "";
        selectedFilterSpotIdString = "";
    }

    private void CloseCreatePost()
    {
        ujBejegyzesNyitva = false;
        createMessage = "";
        postImageMessage = "";
    }

    // ===== ÚJ BEJEGYZÉS LÉTREHOZÁSA =====
    private async Task CreateBejegyzes()
    {
        if (isCreating)
            return;

        createMessage = "";

        if (string.IsNullOrWhiteSpace(ujBejegyzes.Cim) && string.IsNullOrWhiteSpace(ujBejegyzes.Tartalom))
        {
            createMessage = "Adj meg legalább címet vagy tartalmat.";
            return;
        }

        isCreating = true;

        try
        {
            await AuthService.SetAuthorizationHeader();

            ujBejegyzes.SpotID = SelectedSpotId;

            var response = await Http.PostAsJsonAsync("api/forum/bejegyzesek", ujBejegyzes);

            if (response.IsSuccessStatusCode)
            {
                ujBejegyzes = new BejegyzesLetrehozasDto();
                selectedSpotIdString = "";
                createMessage = "";
                postImageMessage = "";
                ujBejegyzesNyitva = false;

                await LoadBejegyzesek();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                createMessage = string.IsNullOrWhiteSpace(errorText)
                    ? "A bejegyzés létrehozása nem sikerült."
                    : $"A bejegyzés létrehozása nem sikerült: {errorText}";
            }
        }
        catch (Exception ex)
        {
            createMessage = $"Hiba történt a bejegyzés létrehozása közben: {ex.Message}";
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    // ===== NAVIGÁCIÓS METÓDUSOK =====
    private void OpenProfil(string? felhasznaloNev)
    {
        if (string.IsNullOrWhiteSpace(felhasznaloNev))
            return;

        Navigation.NavigateTo($"/profil/{felhasznaloNev}");
    }

    private void OpenBejegyzes(int bejegyzesId)
    {
        Navigation.NavigateTo($"/forum/{bejegyzesId}");
    }

    // ===== TARTALOM RENDERELÉS (SPOT TAGEK LINKESÍTÉSE) =====
    private MarkupString RenderTartalom(BejegyzesListaDto bejegyzes)
    {
        var text = bejegyzes.Tartalom ?? "";

        if (!string.IsNullOrWhiteSpace(bejegyzes.SpotSlug))
        {
            var tag = "#" + bejegyzes.SpotSlug;
            if (text.Contains(tag, StringComparison.OrdinalIgnoreCase))
            {
                var encodedUrl = $"/terkep?spot={bejegyzes.SpotSlug}";
                text = text.Replace(tag, $"<a class=\"forum-inline-tag\" href=\"{encodedUrl}\">{tag}</a>", StringComparison.OrdinalIgnoreCase);
            }
        }

        text = text.Replace("\n", "<br>");
        return new MarkupString(text);
    }

    // ===== KÉP FELTÖLTÉS =====
    private async Task UploadPostImageFile(InputFileChangeEventArgs e)
    {
        postImageMessage = "";

        var file = e.File;
        if (file == null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            var imageUrl = await AuthService.UploadForumImage(stream, file.Name);

            if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                ujBejegyzes.KepUrl = imageUrl;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                postImageMessage = "A kép feltöltése nem sikerült.";
            }
        }
        catch (Exception ex)
        {
            postImageMessage = $"Hiba történt a kép feltöltése közben: {ex.Message}";
        }
    }

    // ===== SEGÉDMETÓDUSOK =====
    // Monogram generálás: "Kiss János" → "KJ"
    private string GetMonogram(string? teljesNev, string? felhasznaloNev)
    {
        if (!string.IsNullOrWhiteSpace(teljesNev))
        {
            var parts = teljesNev.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpper();

            return parts[0][0].ToString().ToUpper();
        }

        if (!string.IsNullOrWhiteSpace(felhasznaloNev))
            return felhasznaloNev[0].ToString().ToUpper();

        return "F";
    }

    // Dátum formázás helyi időzónára
    private string FormatDatum(DateTime dateTime)
    {
        return dateTime.ToLocalTime().ToString("yyyy. MM. dd. HH:mm");
    }

    // Slug generálás (magyar ékezetek cseréje)
    private string Slugify(string text)
    {
        return text
            .ToLower()
            .Replace("á", "a")
            .Replace("é", "e")
            .Replace("í", "i")
            .Replace("ó", "o")
            .Replace("ö", "o")
            .Replace("ő", "o")
            .Replace("ú", "u")
            .Replace("ü", "u")
            .Replace("ű", "u")
            .Replace(" ", "-");
    }

