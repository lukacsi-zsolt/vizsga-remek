@page "/Login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@using SzarnysegedP.Services
@using SzarnysegedShared.DTOs.FelhasznaloDTOs

<style>
:root {
        --bg: #f0ece4;
        --surface: #ffffff;
        --border: #d4cfc5;
        --border-focus: #2e6648;
        --text: #1c2b22;
        --muted: #6b7a6e;
        --accent: #2e6648;
        --accent-light: #3d7d5a;
        --accent-glow: rgba(46, 102, 72, 0.15);
        --error: #b94040;
        --error-bg: rgba(185, 64, 64, 0.07);
        --radius: 10px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        background-image:
            radial-gradient(ellipse 70% 60% at 20% 10%, rgba(46,102,72,0.07) 0%, transparent 60%),
            radial-gradient(ellipse 50% 50% at 85% 85%, rgba(46,102,72,0.05) 0%, transparent 55%);
        font-family: 'Source Sans 3', sans-serif;
        padding: 24px;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 48px 40px;
        box-shadow: 0 1px 0 rgba(255,255,255,0.8) inset, 0 20px 60px rgba(28,43,34,0.10), 0 4px 16px rgba(28,43,34,0.06);
        animation: cardIn 0.45s cubic-bezier(0.16,1,0.3,1) both;
    }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .login-brand { text-align: center; margin-bottom: 36px; }

    .brand-icon {
        color: var(--accent);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 30px;
        font-weight: 600;
        color: var(--text);
        letter-spacing: 0.01em;
        line-height: 1.1;
        margin-bottom: 6px;
    }

    .brand-sub {
        font-size: 13px;
        color: var(--muted);
        font-weight: 300;
        letter-spacing: 0.03em;
        font-style: italic;
    }

    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .field-group { display: flex; flex-direction: column; gap: 7px; }

    .field-label {
        font-size: 11px;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .input-wrapper { position: relative; display: flex; align-items: center; }

    .input-icon {
        position: absolute;
        left: 13px;
        color: var(--muted);
        display: flex;
        align-items: center;
        pointer-events: none;
        transition: color 0.2s;
    }

    .field-input {
        width: 100%;
        background: #fafaf8;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 12px 13px 12px 40px;
        font-size: 14px;
        font-family: 'Source Sans 3', sans-serif;
        color: var(--text);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        -webkit-appearance: none;
    }

    .field-input::placeholder { color: #b0aa9e; }

    .field-input:focus {
        border-color: var(--border-focus);
        background: #ffffff;
        box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .input-wrapper:focus-within .input-icon { color: var(--accent); }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--error-bg);
        border: 1px solid rgba(185,64,64,0.2);
        border-radius: var(--radius);
        padding: 10px 13px;
        font-size: 13px;
        color: var(--error);
        animation: shakeIn 0.3s ease;
    }

    @@keyframes shakeIn {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    .login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 24px;
        margin-top: 6px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: var(--radius);
        font-family: 'Source Sans 3', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
        box-shadow: 0 3px 16px rgba(46,102,72,0.28);
    }

    .login-btn:hover:not(:disabled) {
        background: var(--accent-light);
        transform: translateY(-1px);
        box-shadow: 0 6px 24px rgba(46,102,72,0.38);
    }

    .login-btn:active:not(:disabled) { transform: translateY(0); box-shadow: 0 2px 8px rgba(46,102,72,0.25); }
    .login-btn:disabled, .login-btn.loading { opacity: 0.65; cursor: not-allowed; }

    .spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

<PageTitle>Bejelentkezés</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-brand">
            <div class="brand-icon">✦</div>
            <h1 class="brand-title">Szárnysegéd</h1>
            <p class="brand-sub">Üdvözöljük újra</p>
        </div>

        <div class="login-form">
            <div class="field-group">
                <label class="field-label">Felhasználónév</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    <input class="field-input"
                           @bind="model.Username"
                           @bind:event="oninput"
                           placeholder="pl. kiss.janos"
                           autocomplete="username" />
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">Jelszó</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </span>
                    <input class="field-input"
                           type="password"
                           @bind="model.Password"
                           @bind:event="oninput"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-banner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    @errorMessage
                </div>
            }

            <button class="login-btn @(isLoading ? "loading" : "")"
                    @onclick="LoginUser"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Bejelentkezés...</span>
                }
                else
                {
                    <span>Bejelentkezés</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                }
            </button>
        </div>
    </div>
</div>

@* 
<input @bind="model.Username" placeholder="Felhasználónév" />
<input type="password" @bind="model.Password" placeholder="Jelszó" />

<button @onclick="LoginUser">Login</button>

 *@



@code {
    LoginDTO model = new();
    bool isLoading = false;
    string errorMessage = "";

    async Task LoginUser()
    {
        if (isLoading) return;
        errorMessage = "";
        isLoading = true;

        try
        {
            var success = await AuthService.Login(model);
            if (success)
                Navigation.NavigateTo("/");
            else
                errorMessage = "Hibás felhasználónév vagy jelszó.";
        }
        catch
        {
            errorMessage = "Kapcsolódási hiba. Kérjük, próbálja újra.";
        }
        finally
        {
            isLoading = false;
        }
    }
}