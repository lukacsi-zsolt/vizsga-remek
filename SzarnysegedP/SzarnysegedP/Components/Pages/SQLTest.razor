@using SzarnysegedShared.DTOs
@using SzarnysegedShared.DTOs.FelhasznaloDTOs
@using SzarnysegedShared.DTOs.HirDTOs
@inject HirService HirService
@inject FelhasznaloService FelhasznaloService
@page "/SQLTest"

<h3>Hírek</h3>

@if (hirek == null)
{
    <p>Loading...</p>
}
else if (!hirek.Any())
{
    <p>Nincs hír.</p>
}
else
{
    @foreach (var hir in hirek)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h4>@hir.Cim</h4>
                <p>@hir.Tartalom</p>
                <small>Kategória: @hir.Kategoria</small><br />
                <small>Dátum: @hir.Datum.ToShortDateString()</small>
            </div>
        </div>
    }
}

@foreach (var f in felhasznalok)
{
    <h3>@f.FelhasznaloNev</h3>
    <h3>@f.Email</h3>
    <h3>@f.Email</h3>
}


@code {
    private List<HirDto>? hirek;
    private List<FelhasznaloDTO>? felhasznalok;

    protected override async Task OnInitializedAsync()
    {
        hirek = await HirService.GetHirekAsync();
		felhasznalok = await FelhasznaloService.GetFelhasznalokAsync();
    }
}