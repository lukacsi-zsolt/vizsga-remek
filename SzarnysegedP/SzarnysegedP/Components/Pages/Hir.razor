@page "/Hirek/{id:int}"
@using SzarnysegedShared.DTOs.HirDTOs
@inject HirService HirService
@inject NavigationManager Nav

<PageTitle>Hír részletei</PageTitle>

<style>
    .hir-detail-page {
        background: #f5f0e8;
        min-height: calc(100vh - 64px);
        padding: 48px 20px 72px;
    }

    .hir-detail-wrap {
        max-width: 980px;
        margin: 0 auto;
    }

    .hir-back-btn {
        background: transparent;
        border: none;
        padding: 0;
        margin: 0 0 18px;
        color: #2d5a3d;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .hir-back-btn:hover {
        text-decoration: underline;
    }

    .hir-detail-state {
        background: #ffffff;
        border: 1px solid rgba(92,74,50,0.10);
        border-radius: 14px;
        padding: 36px 30px;
        text-align: center;
        color: #5c4a32;
        box-shadow: 0 10px 28px rgba(92,74,50,0.08);
    }

    .hir-detail-card {
        background: #ffffff;
        border: 1px solid rgba(92,74,50,0.10);
        border-radius: 16px;
        box-shadow: 0 14px 34px rgba(92,74,50,0.10);
        overflow: hidden;
    }

    .hir-detail-header {
        padding: 34px 38px 22px;
        background: linear-gradient(135deg, #0f2d1f 0%, #1a4a2e 60%, #2d5a3d 100%);
        color: #ffffff;
    }

    .hir-detail-tag {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.16);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .hir-detail-title {
        margin: 0 0 14px;
        font-family: 'Playfair Display', serif;
        font-size: clamp(34px, 5vw, 52px);
        line-height: 1.12;
        font-weight: 700;
        color: #ffffff;
    }

    .hir-detail-date {
        color: rgba(255,255,255,0.82);
        font-size: 14px;
    }

    .hir-detail-body {
        padding: 34px 38px 40px;
    }

    .hir-lead {
        margin: 0 0 24px;
        font-size: 19px;
        line-height: 1.8;
        color: #2e2416;
        font-weight: 600;
    }

    .hir-divider {
        width: 100%;
        height: 1px;
        background: rgba(92,74,50,0.10);
        margin: 0 0 26px;
    }

    .hir-content p {
        margin: 0 0 18px;
        color: #5c4a32;
        font-size: 16px;
        line-height: 1.95;
    }

    @@media (max-width: 768px) {
        .hir-detail-page {
            padding: 34px 16px 56px;
        }

        .hir-detail-header {
            padding: 26px 22px 18px;
        }

        .hir-detail-body {
            padding: 24px 22px 28px;
        }

        .hir-detail-title {
            font-size: 34px;
        }

        .hir-lead {
            font-size: 17px;
        }

        .hir-content p {
            font-size: 15px;
        }
    }
</style>

<section class="hir-detail-page">
    <div class="hir-detail-wrap">
        <button class="hir-back-btn" @onclick="GoBack">← Vissza a hírekhez</button>

        @if (isLoading)
        {
            <div class="hir-detail-state">Betöltés...</div>
        }
        else if (hir == null)
        {
            <div class="hir-detail-state">
                <p>Ez a hír nem található.</p>
            </div>
        }
        else
        {
            <article class="hir-detail-card">
                <header class="hir-detail-header">
                    @if (!string.IsNullOrWhiteSpace(hir.Kategoria))
                    {
                        <span class="hir-detail-tag">@hir.Kategoria</span>
                    }
                    else
                    {
                        <span class="hir-detail-tag">Hír</span>
                    }

                    <h1 class="hir-detail-title">@hir.Cim</h1>
                    <div class="hir-detail-date">@hir.Datum.ToString("yyyy. MM. dd.")</div>
                </header>

                <div class="hir-detail-body">
                    <p class="hir-lead">@GetLeadText(hir.Tartalom)</p>

                    <div class="hir-divider"></div>

                    <div class="hir-content">
                        @foreach (var paragraph in GetParagraphs(hir.Tartalom))
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    private HirDto? hir;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        hir = await HirService.GetHirByIdAsync(id);
        isLoading = false;
    }

    private void GoBack()
    {
        Nav.NavigateTo("/Hirek");
    }

    private List<string> GetParagraphs(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return new List<string>();

        return text
            .Split(new[] { "\r\n\r\n", "\n\n", "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    private string GetLeadText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var cleaned = text.Replace("\r\n", " ").Replace("\n", " ").Trim();

        if (cleaned.Length <= 180)
            return cleaned;

        return cleaned.Substring(0, 180).Trim() + "...";
    }
}