@page "/profil/szerkesztes"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using SzarnysegedShared.DTOs.FelhasznaloDTOs
@inject SzarnysegedP.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Profil szerkesztése – Szárnysegéd</PageTitle>

@* ===== FELTÉTELES RENDERELÉS ===== *@
@if (isLoading)
{
    <div class="profil-edit-loading">
        <p>Profil betöltése...</p>
    </div>
}
else
{
    @* ===== BORÍTÓKÉP ELŐNÉZET A FEJLÉCBEN ===== *@
    @* A háttérkép dinamikusan változik, ahogy a felhasználó új borítóképet tölt fel *@
    <div class="profil-edit-hero" style="background-image: url('@GetCoverPreviewUrl()')">
        <div class="profil-edit-hero-overlay"></div>
        <div class="profil-edit-hero-inner">
            <h1>Profil szerkesztése</h1>
            <p>Állítsd be, hogyan látnak téged a közösség tagjai.</p>
        </div>
    </div>

    <div class="profil-edit-wrapper">
        @* Kétoszlopos elrendezés: bal oldalon előnézet, jobb oldalon szerkesztő űrlapok *@
        <div class="profil-edit-layout">

            @* ===== BAL OLDAL: ÉLŐBEN FRISSÜLŐ ELŐNÉZET ===== *@
            @* Az előnézet automatikusan frissül, ahogy a felhasználó gépel az inputokba *@
            @* Ez a @bind kétirányú adatkötésnek köszönhető – a model változik → a UI frissül *@
            <aside class="profil-edit-side">
                <div class="profil-card">
                    <h3 class="profil-card-cim">Előnézet</h3>

                    <div class="profil-edit-preview">
                        @* Avatar előnézet: ha van kép → megjelenítjük, ha nincs → monogram *@
                        @if (!string.IsNullOrWhiteSpace(model.AvatarUrl))
                        {
                            <img class="profil-edit-preview-avatar-img"
                                 src="@model.AvatarUrl"
                                 alt="Profilkép előnézet" />
                        }
                        else
                        {
                            <div class="profil-edit-avatar">
                                @GetMonogram()
                            </div>
                        }

                        @* Név előnézet: ha üres, placeholder szöveget mutat *@
                        <h4>@(string.IsNullOrWhiteSpace(model.TeljesNev) ? "Teljes név" : model.TeljesNev)</h4>
                        <p>
                            @if (!string.IsNullOrWhiteSpace(model.FelhasznaloNev))
                            {
                                @("@"+model.FelhasznaloNev)
                            }
                            else
                            {
                                @("@felhasznalo")
                            }
                        </p>

                        @* Bio előnézet – csak akkor jelenik meg, ha ki van töltve *@
                        @if (!string.IsNullOrWhiteSpace(model.Bio))
                        {
                            <div class="profil-edit-preview-bio">@model.Bio</div>
                        }

                        @* Helyszín és Klub badge-ek *@
                        <div class="profil-edit-preview-tags">
                            @if (!string.IsNullOrWhiteSpace(model.Helyszin))
                            {
                                <span class="profil-badge profil-badge-outline">@model.Helyszin</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(model.Klub))
                            {
                                <span class="profil-badge profil-badge-outline">@model.Klub</span>
                            }
                        </div>
                    </div>
                </div>
            </aside>

            @* ===== JOBB OLDAL: SZERKESZTŐ ŰRLAPOK ===== *@
            <section class="profil-edit-main">
                @* --- Alapadatok kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Alapadatok</h3>

                    @* Visszajelzés üzenetek (mentés eredménye / feltöltés státusz) *@
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="profil-edit-message">@message</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(uploadMessage))
                    {
                        <div class="profil-edit-message">@uploadMessage</div>
                    }

                    @* Kétoszlopos grid az alapadatoknak *@
                    <div class="profil-edit-grid">
                        <div class="profil-edit-field">
                            <label>Felhasználónév</label>
                            <input @bind="model.FelhasznaloNev" />
                        </div>

                        <div class="profil-edit-field">
                            <label>Teljes név</label>
                            <input @bind="model.TeljesNev" />
                        </div>

                        <div class="profil-edit-field">
                            <label>Email</label>
                            <input type="email" @bind="model.Email" />
                        </div>

                        <div class="profil-edit-field">
                            <label>Születési dátum</label>
                            <input type="date" @bind="model.SzuletesiDatum" />
                        </div>
                    </div>
                </div>

                @* --- Profilinformációk kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Profilinformációk</h3>

                    <div class="profil-edit-grid-single">
                        <div class="profil-edit-field">
                            <label>Bemutatkozás</label>
                            <textarea rows="5" @bind="model.Bio"></textarea>
                        </div>

                        <div class="profil-edit-field">
                            <label>Helyszín</label>
                            <input @bind="model.Helyszin" placeholder="pl. Velence-hegység, HU" />
                        </div>

                        <div class="profil-edit-field">
                            <label>Klub</label>
                            <input @bind="model.Klub" placeholder="pl. Dunántúli Siklóernyős Egyesület" />
                        </div>
                    </div>
                </div>

                @* --- Képek kártya (fájl feltöltés) --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Képek</h3>

                    <div class="profil-edit-grid-single">
                        @* ===== AVATAR (PROFILKÉP) FELTÖLTÉS ===== *@
                        <div class="profil-edit-field">
                            <label>Profilkép feltöltése</label>
                            <InputFile OnChange="UploadAvatarFile" accept=".jpg,.jpeg,.png,.webp" />

                            @* Feltöltött kép előnézete *@
                            @if (!string.IsNullOrWhiteSpace(model.AvatarUrl))
                            {
                                <div class="profil-edit-image-preview profil-edit-avatar-preview">
                                    <img src="@model.AvatarUrl" alt="Profilkép előnézet" />
                                </div>
                            }
                        </div>

                        @* ===== BORÍTÓKÉP FELTÖLTÉS ===== *@
                        <div class="profil-edit-field">
                            <label>Borítókép feltöltése</label>
                            <InputFile OnChange="UploadCoverFile" accept=".jpg,.jpeg,.png,.webp" />

                            @if (!string.IsNullOrWhiteSpace(model.CoverUrl))
                            {
                                <div class="profil-edit-image-preview profil-edit-cover-preview">
                                    <img src="@model.CoverUrl" alt="Borítókép előnézet" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ===== AKCIÓ GOMBOK ===== *@
                <div class="profil-edit-actions">
                    @* Mentés gomb – disabled állapot mentés közben (dupla kattintás védelem) *@
                    <button type="button" class="btn-primary-custom" @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Mentés..." : "Változtatások mentése")
                    </button>

                    @* Mégse gomb – visszanavigál a profiloldalra mentés nélkül *@
                    <button type="button" class="profil-edit-cancel" @onclick="Cancel">
                        Mégse
                    </button>
                </div>
            </section>
        </div>
    </div>
}

@code {
    // ===== ÁLLAPOTVÁLTOZÓK =====
    private UpdateFelhasznaloDto model = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string message = "";
    private string uploadMessage = "";

    // ===== ÉLETCIKLUS: ELSŐ RENDERELÉS UTÁN =====
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var user = await AuthService.GetCurrentUser();

        if (user == null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        // A DTO feltöltése a felhasználó aktuális adataival
        // Ez jelenik meg az inputokban alapértékként (amit aztán szerkeszthet)
        model = new UpdateFelhasznaloDto
        {
            FelhasznaloNev = user.FelhasznaloNev ?? "",
            TeljesNev = user.TeljesNev ?? "",
            Email = user.Email ?? "",
            SzuletesiDatum = user.SzuletesiDatum,
            Bio = user.Bio,
            Helyszin = user.Helyszin,
            Klub = user.Klub,
            AvatarUrl = user.AvatarUrl,
            CoverUrl = user.CoverUrl
        };

        if (string.IsNullOrWhiteSpace(model.CoverUrl))
            model.CoverUrl = "/images/kodos.jpg";

        isLoading = false;
        StateHasChanged();
    }

    // ===== MENTÉS =====
    // A "Változtatások mentése" gomb @onclick eseménye
    private async Task Save()
    {
        if (isSaving)
            return;

        message = "";
        uploadMessage = "";
        isSaving = true;

        try
        {
            var success = await AuthService.UpdateProfile(model);

            if (success)
            {
                Navigation.NavigateTo("/profil", forceLoad: true);
                return;
            }

            message = "A mentés nem sikerült. Ellenőrizd az adatokat, és próbáld újra.";
        }
        catch
        {
            message = "Hiba történt a mentés közben.";
        }
        finally
        {
            isSaving = false;
        }
    }

    // ===== MÉGSE =====
    // Visszanavigál a profiloldalra mentés nélkül
    private void Cancel()
    {
        Navigation.NavigateTo("/profil");
    }

    // ===== AVATAR FELTÖLTÉS =====
    private async Task UploadAvatarFile(InputFileChangeEventArgs e)
    {
        uploadMessage = "";

        var file = e.File;
        if (file == null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var imageUrl = await AuthService.UploadAvatar(stream, file.Name);

            if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                model.AvatarUrl = imageUrl;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                uploadMessage = "A profilkép feltöltése nem sikerült.";
            }
        }
        catch
        {
            uploadMessage = "Hiba történt a profilkép feltöltése közben.";
        }
    }

    // ===== BORÍTÓKÉP FELTÖLTÉS =====
    // Ugyanaz a logika mint az avatar feltöltésnél
    private async Task UploadCoverFile(InputFileChangeEventArgs e)
    {
        uploadMessage = "";

        var file = e.File;
        if (file == null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var imageUrl = await AuthService.UploadCover(stream, file.Name);

            if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                model.CoverUrl = imageUrl;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                uploadMessage = "A borítókép feltöltése nem sikerült.";
            }
        }
        catch
        {
            uploadMessage = "Hiba történt a borítókép feltöltése közben.";
        }
    }

    // ===== SEGÉDMETÓDUSOK =====
    private string GetMonogram()
    {
        if (string.IsNullOrWhiteSpace(model.TeljesNev))
            return "F";

        var parts = model.TeljesNev
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return parts[0][0].ToString().ToUpper();
    }

    private string GetCoverPreviewUrl()
    {
        if (!string.IsNullOrWhiteSpace(model.CoverUrl))
            return model.CoverUrl!;

        return "/images/kodos.jpg";
    }
}