@page "/Terkep"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using SzarnysegedP.Services
@inject IJSRuntime JS
@inject IConfiguration Config
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Térkép</PageTitle>

<link rel="stylesheet" href="/css/terkep-extra.css">


<style>
    .terkep-page {
        background: var(--cream);
        min-height: 100vh;
        padding: 40px 20px 70px;
    }

    .terkep-wrap {
        max-width: 1250px;
        margin: 0 auto;
    }

    .terkep-hero {
        margin-bottom: 28px;
        text-align: center;
    }

    .terkep-hero h1 {
        margin: 0 0 10px;
        font-family: 'Playfair Display', serif;
        font-size: clamp(34px, 5vw, 50px);
        color: var(--text-dark);
        line-height: 1.12;
    }

    .terkep-hero p {
        margin: 0 auto;
        max-width: 760px;
        color: var(--brown-light);
        font-size: 15px;
        line-height: 1.8;
    }

    .terkep-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .terkep-layout {
        display: grid;
        grid-template-columns: 1.4fr 0.9fr;
        gap: 22px;
        align-items: start;
    }

    .terkep-card {
        background: var(--white);
        border: 1px solid rgba(92,74,50,0.12);
        border-radius: 12px;
        box-shadow: 0 8px 28px rgba(92,74,50,0.08);
        overflow: hidden;
    }

    .terkep-map-card {
        padding: 18px;
    }

    .terkep-map-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .terkep-map-head h2,
    .terkep-side-head h2,
    .terkep-modal-head h2 {
        margin: 0;
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        color: var(--text-dark);
    }

    .terkep-map-sub {
        color: var(--brown-light);
        font-size: 13px;
    }

    #mapbox-map {
        width: 100%;
        height: 620px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(92,74,50,0.10);
    }

    .terkep-side {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .terkep-side-card {
        padding: 22px;
    }

    .terkep-side-head {
        margin-bottom: 14px;
    }

    .terkep-side-head p {
        margin: 8px 0 0;
        color: var(--brown-light);
        font-size: 14px;
        line-height: 1.7;
    }

    .terkep-search {
        margin-bottom: 14px;
    }

    .terkep-search input {
        width: 100%;
        border: 1px solid rgba(92,74,50,0.15);
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 14px;
        color: var(--text-dark);
        background: #fff;
    }

    .terkep-search input:focus,
    .terkep-form-field input:focus,
    .terkep-form-field textarea:focus {
        outline: none;
        border-color: var(--green-mid);
        box-shadow: 0 0 0 3px rgba(45,90,61,0.10);
    }

    .spot-table-wrap {
        overflow: auto;
        border: 1px solid rgba(92,74,50,0.08);
        border-radius: 10px;
    }

    .spot-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 420px;
    }

    .spot-table thead th {
        background: rgba(245,240,232,0.7);
        color: var(--brown);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 1px solid rgba(92,74,50,0.10);
    }

    .spot-table tbody td {
        padding: 13px 14px;
        border-bottom: 1px solid rgba(92,74,50,0.08);
        font-size: 14px;
        color: var(--brown);
        vertical-align: middle;
    }

    .spot-table tbody tr {
        cursor: pointer;
        transition: background 0.18s ease;
    }

    .spot-table tbody tr:hover {
        background: rgba(245,240,232,0.55);
    }

    .spot-name-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .spot-color-dot {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .terkep-help-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 4px;
    }

    .terkep-help-item {
        padding: 12px 14px;
        border-radius: 8px;
        background: rgba(45,90,61,0.05);
        border: 1px solid rgba(45,90,61,0.10);
        color: var(--brown);
        font-size: 14px;
        line-height: 1.7;
    }

    .terkep-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(45,90,61,0.08);
        color: var(--green-mid);
        border: 1px solid rgba(45,90,61,0.14);
        font-size: 12px;
        font-weight: 700;
    }

    .terkep-empty {
        color: var(--brown-light);
        font-size: 14px;
        text-align: center;
        padding: 18px 8px;
    }

    .terkep-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15,45,31,0.22);
        display: flex;
        justify-content: flex-end;
        align-items: stretch;
        padding: 0;
        z-index: 3000;
        pointer-events: none;
    }

    .terkep-modal {
        width: min(460px, 100%);
        height: 100vh;
        overflow: auto;
        background: var(--white);
        box-shadow: -12px 0 36px rgba(0,0,0,0.18);
        border-left: 1px solid rgba(92,74,50,0.12);
        pointer-events: auto;
    }

    .terkep-modal-head {
        padding: 24px 24px 8px;
    }

    .terkep-modal-head p {
        margin: 8px 0 0;
        color: var(--brown-light);
        font-size: 14px;
        line-height: 1.7;
    }

    .terkep-modal-body {
        padding: 18px 24px 24px;
    }

    .terkep-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .terkep-form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .terkep-form-field.full {
        grid-column: 1 / -1;
    }

    .terkep-form-field label {
        color: var(--brown);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .terkep-form-field input,
    .terkep-form-field textarea {
        width: 100%;
        border: 1px solid rgba(92,74,50,0.15);
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 14px;
        color: var(--text-dark);
        font-family: 'Lato', 'Segoe UI', Tahoma, sans-serif;
        background: #fff;
    }

    .terkep-form-field textarea {
        min-height: 120px;
        resize: vertical;
        line-height: 1.7;
    }

    .terkep-note {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 8px;
        background: rgba(45,90,61,0.06);
        border: 1px solid rgba(45,90,61,0.12);
        color: var(--green-mid);
        font-size: 13px;
        line-height: 1.7;
    }

    .terkep-message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fff4e8;
        border: 1px solid rgba(122,110,95,0.22);
        color: var(--brown);
        font-size: 13px;
    }

    .terkep-modal-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .terkep-btn-muted {
        background: transparent;
        border: 1px solid rgba(92,74,50,0.22);
        color: var(--brown);
        padding: 13px 24px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
    }

    .terkep-btn-muted:hover {
        background: var(--cream);
        transform: translateY(-1px);
    }

    .terkep-btn-admin {
        background: var(--green-mid);
        color: var(--white);
        border: none;
        padding: 13px 24px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
    }

    .terkep-btn-admin:hover {
        background: var(--green-dark);
        transform: translateY(-1px);
    }

    .terkep-btn-secondary {
        border: 1px solid rgba(92,74,50,0.22);
        background: var(--white);
        color: var(--brown);
        padding: 13px 24px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
    }

    .terkep-btn-secondary:hover {
        background: var(--cream);
        transform: translateY(-1px);
    }
    html, body {
    overflow-x: hidden;
    }

    .terkep-page,
    .terkep-wrap,
    .terkep-layout,
    .terkep-card,
    .terkep-map-card,
    .terkep-side,
    .terkep-side-card {
        max-width: 100%;
        box-sizing: border-box;
    }

    .terkep-layout > * {
        min-width: 0;
    }

    .spot-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .spot-table {
        width: 100%;
    }

    @@media (max-width: 991px) {
        .terkep-layout {
            display: flex !important;
            flex-direction: column !important;
            gap: 16px !important;
        }

        .terkep-map-card,
        .terkep-side {
            width: 100% !important;
            max-width: 100% !important;
        }

        .terkep-side {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        #mapbox-map {
            width: 100% !important;
            height: 420px !important;
        }
    }

    @@media (max-width: 640px) {
        .terkep-page {
            padding: 18px 10px 36px !important;
        }

        .terkep-wrap {
            width: 100% !important;
            max-width: 100% !important;
        }

        .terkep-card,
        .terkep-map-card,
        .terkep-side-card {
            width: 100% !important;
            max-width: 100% !important;
            border-radius: 10px !important;
            padding: 12px !important;
            overflow: hidden;
        }

        .terkep-actions {
            display: flex !important;
            flex-direction: column !important;
            gap: 10px !important;
        }

        .terkep-actions > * {
            width: 100% !important;
        }

        #mapbox-map {
            height: 320px !important;
        }

        .spot-table {
            min-width: 0 !important;
            table-layout: fixed;
        }

        .spot-table thead th,
        .spot-table tbody td {
            font-size: 12px !important;
            padding: 9px 8px !important;
            word-break: break-word;
        }

        .spot-name-cell {
            font-size: 12px !important;
        }
    }
    @@media (max-width: 700px) {
        .terkep-modal-backdrop {
            align-items: flex-end;
            justify-content: center;
            background: rgba(15,45,31,0.35);
            pointer-events: auto;
        }

        .terkep-modal {
            width: 100%;
            max-height: 88vh;
            height: auto;
            border-left: none;
            border-top-left-radius: 14px;
            border-top-right-radius: 14px;
            box-shadow: 0 -12px 36px rgba(0,0,0,0.2);
        }
    }


</style>

<section class="terkep-page">
    <div class="terkep-wrap">
        <div class="terkep-hero">
            <h1>Repülőhelyek térképen</h1>
            <p>
                Böngészd a starthelyeket interaktív térképen, nézd meg a fő adatokat,
                és ha új helyet ismersz, adminként hozzáadhatod, felhasználóként pedig javasolhatod.
            </p>

            <div class="terkep-actions">
                @if (isAdmin)
                {
                    <button class="terkep-btn-admin" @onclick="OpenAdminCreateModal">
                        Új spot hozzáadása
                    </button>
                }
                else if (isLoggedIn)
                {
                    <button class="terkep-btn-secondary" @onclick="OpenSuggestionModal">
                        Spot javaslása
                    </button>
                }

                <a href="/Info" class="btn-secondary-custom">Repülési tudnivalók</a>
            </div>
        </div>

        <div class="terkep-layout">
            <div class="terkep-card terkep-map-card">
                <div class="terkep-map-head">
                    <div>
                        <h2>Térkép</h2>
                        <div class="terkep-map-sub">
                            Kattints a táblázat soraira a térképre ugráshoz.
                            @if (isAdmin || isLoggedIn)
                            {
                                <span> A form megnyitása után a térképre kattintva kitölthetők a koordináták.</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedSpotSlug))
                    {
                        <span class="terkep-badge">Kiemelt spot: @selectedSpotSlug</span>
                    }
                </div>

                <div id="mapbox-map"></div>
            </div>

            <div class="terkep-side">
                <div class="terkep-card terkep-side-card">
                    <div class="terkep-side-head">
                        <h2>Spot lista</h2>
                        <p>Kereshetsz név, ország vagy megye alapján.</p>
                    </div>

                    <div class="terkep-search">
                        <input placeholder="Keresés..." value="@searchText" @oninput="HandleSearchInput" />
                    </div>

                    @if (filteredSpotok.Count == 0)
                    {
                        <div class="terkep-empty">Nincs találat.</div>
                    }
                    else
                    {
                        <div class="spot-table-wrap">
                            <table class="spot-table">
                                <thead>
                                    <tr>
                                        <th>Név</th>
                                        <th>Ország</th>
                                        <th>Magasság</th>
                                        <th>Szél</th>
                                    </tr>
                                </thead>
                                <tbody id="spot-list"></tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="terkep-card terkep-side-card">
                    <div class="terkep-side-head">
                        <h2>Mit jelentenek a színek?</h2>
                    </div>

                    <div class="terkep-help-list">
                        <div class="terkep-help-item">
                            <strong style="color:#4985c9;">Kék marker</strong><br />
                            Alacsonyabb magasságú spot vagy hiányzó magassági adat.
                        </div>

                        <div class="terkep-help-item">
                            <strong style="color:#fcba03;">Sárga marker</strong><br />
                            Közepes magasságú repülőhely.
                        </div>

                        <div class="terkep-help-item">
                            <strong style="color:#fc0341;">Piros marker</strong><br />
                            Magasabban fekvő repülőhely.
                        </div>
                    </div>
                </div>

                <div class="terkep-card terkep-side-card">
                    <div class="terkep-side-head">
                        <h2>Admin működés</h2>
                    </div>

                    <div class="terkep-help-list">
                        <div class="terkep-help-item">
                            <strong>Admin:</strong> közvetlenül létrehozhat új spotot.
                        </div>
                        <div class="terkep-help-item">
                            <strong>Felhasználó:</strong> új helyet javasolhat, amit az admin jóváhagyhat az admin felületen.
                        </div>
                        <div class="terkep-help-item">
                            <strong>Szerkesztés és törlés:</strong> kizárólag az admin oldalon történik.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (showModal)
{
    <div class="terkep-modal-backdrop">
        <div class="terkep-modal">
            <div class="terkep-modal-head" style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                <h2>@(isAdminCreateMode ? "Új spot hozzáadása" : "Spot javaslása")</h2>
                <p>
                    Töltsd ki az adatokat, majd kattints a térképre a koordináták gyors megadásához.
                </p>
                <button class="terkep-btn-muted" type="button" @onclick="CloseModal">✕</button>
            </div>

            <div class="terkep-modal-body">
                @if (!string.IsNullOrWhiteSpace(formMessage))
                {
                    <div class="terkep-message">@formMessage</div>
                }

                <div class="terkep-form-grid">
                    <div class="terkep-form-field">
                        <label>Név</label>
                        <input @bind="spotForm.Nev" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Ország</label>
                        <input @bind="spotForm.Orszag" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Megye</label>
                        <input @bind="spotForm.Megye" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Magasság (m)</label>
                        <input type="number" @bind="spotForm.Magassag" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Átlag szél</label>
                        <input type="number" step="0.1" @bind="spotForm.AtlagSzel" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Latitude</label>
                        <input type="number" step="any" @bind="spotForm.Lat" />
                    </div>

                    <div class="terkep-form-field">
                        <label>Longitude</label>
                        <input type="number" step="any" @bind="spotForm.Lon" />
                    </div>

                    @if (isAdminCreateMode)
                    {
                        <div class="terkep-form-field">
                            <label>Slug</label>
                            <input @bind="spotForm.Slug" />
                        </div>
                    }

                    <div class="terkep-form-field full">
                        <label>Hely leírása</label>
                        <textarea @bind="spotForm.HelyLeiras"></textarea>
                    </div>

                    <div class="terkep-form-field full">
                        <label>Szabályok</label>
                        <textarea @bind="spotForm.Szabalyok"></textarea>
                    </div>
                </div>

                <div class="terkep-note">
                    Tipp: nyisd meg a formot, majd kattints a térképre — a rendszer automatikusan beírja a koordinátákat.
                </div>

                <div class="terkep-modal-actions">
                    <button class="terkep-btn-admin" @onclick="SubmitSpotAsync" disabled="@isSubmitting">
                        @(isSubmitting ? "Mentés..." : (isAdminCreateMode ? "Spot létrehozása" : "Javaslat beküldése"))
                    </button>

                    <button class="terkep-btn-muted" @onclick="CloseModal">
                        Mégse
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DotNetObjectReference<Terkep>? dotNetRef;

    private bool mapInitialized;
    private bool isLoggedIn;
    private bool isAdmin;
    private bool showModal;
    private bool isAdminCreateMode;
    private bool isSubmitting;

    private string? selectedSpotSlug;
    private string searchText = "";
    private string? formMessage;

    private List<SpotDto> spotok = new();

    private SpotFormModel spotForm = new();

    private string MapboxKey => Config["ApiTokens:MapboxKey"] ?? "";
    private string ApiBaseUrl => Config["ApiBaseUrl"] ?? "";
    private string FilteredJson => System.Text.Json.JsonSerializer.Serialize(filteredSpotok);

    private List<SpotDto> filteredSpotok =>
        spotok.Where(MatchesSearch).ToList();

    protected override async Task OnInitializedAsync()
    {
        selectedSpotSlug = TryGetSpotSlugFromUrl();
        isLoggedIn = await AuthService.IsLoggedIn();
        isAdmin = await AuthService.IsAdmin();

        spotok = await LoadSpotokAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || mapInitialized)
            return;

        dotNetRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("setMapboxConfig", MapboxKey, selectedSpotSlug, ApiBaseUrl);
        await JS.InvokeVoidAsync("setMapboxDotNetRef", dotNetRef);
        await JS.InvokeVoidAsync("setInitialSpotData", filteredSpotok);
        await JS.InvokeVoidAsync("initMapbox", "mapbox-map");

        mapInitialized = true;
    }

    private async Task<List<SpotDto>> LoadSpotokAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<SpotDto>>("api/spotok");
            return result ?? new List<SpotDto>();
        }
        catch
        {
            return new List<SpotDto>();
        }
    }

    private bool MatchesSearch(SpotDto s)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var q = searchText.Trim().ToLowerInvariant();

        return (s.Nev?.ToLowerInvariant().Contains(q) ?? false)
            || (s.Orszag?.ToLowerInvariant().Contains(q) ?? false)
            || (s.Megye?.ToLowerInvariant().Contains(q) ?? false)
            || (s.Slug?.ToLowerInvariant().Contains(q) ?? false);
    }

    private string? TryGetSpotSlugFromUrl()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("spot", out var value))
            return value.ToString();

        return null;
    }

    private async Task RefreshJsSpotsAsync()
    {
        if (!mapInitialized)
            return;

        await JS.InvokeVoidAsync("setInitialSpotData", filteredSpotok);
        await JS.InvokeVoidAsync("reloadMapboxSpots");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (mapInitialized)
        {
            await RefreshJsSpotsAsync();
        }
    }

    private void OpenAdminCreateModal()
    {
        if (!isAdmin)
            return;

        isAdminCreateMode = true;
        formMessage = null;
        showModal = true;
        spotForm = new SpotFormModel();
        _ = JS.InvokeVoidAsync("enableMapClickSelection", true);
    }

    private void OpenSuggestionModal()
    {
        if (!isLoggedIn || isAdmin)
            return;

        isAdminCreateMode = false;
        formMessage = null;
        showModal = true;
        spotForm = new SpotFormModel();
        _ = JS.InvokeVoidAsync("enableMapClickSelection", true);
    }

    private async void CloseModal()
    {
        showModal = false;
        formMessage = null;
        await JS.InvokeVoidAsync("enableMapClickSelection", false);
        StateHasChanged();
    }

    [JSInvokable]
    public Task HandleMapClick(double lat, double lon)
    {
        if (!showModal)
            return Task.CompletedTask;

        spotForm.Lat = lat;
        spotForm.Lon = lon;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SubmitSpotAsync()
    {
        formMessage = null;

        if (string.IsNullOrWhiteSpace(spotForm.Nev))
        {
            formMessage = "A spot neve kötelező.";
            return;
        }

        if (spotForm.Lat == null || spotForm.Lon == null)
        {
            formMessage = "A koordináták kötelezőek. Kattints a térképre vagy írd be kézzel.";
            return;
        }

        isSubmitting = true;

        try
        {
            await AuthService.SetAuthorizationHeader();

            HttpResponseMessage response;

            if (isAdminCreateMode && isAdmin)
            {
                response = await Http.PostAsJsonAsync("api/spotok", spotForm.ToSpotCreateRequest());
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/spotok/javaslat", spotForm.ToSuggestionRequest());
            }

            if (response.IsSuccessStatusCode)
            {
                if (isAdminCreateMode)
                {
                    spotok = await LoadSpotokAsync();
                    await RefreshJsSpotsAsync();
                    formMessage = "A spot sikeresen létrejött.";
                }
                else
                {
                    formMessage = "A javaslat sikeresen elküldve. Az admin jóváhagyás után fog megjelenni.";
                }

                await Task.Delay(900);
                CloseModal();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                formMessage = string.IsNullOrWhiteSpace(error)
                    ? "Mentési hiba történt."
                    : error;
            }
        }
        catch
        {
            formMessage = "Váratlan hiba történt a mentés közben.";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
            dotNetRef.Dispose();

        if (mapInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("disposeMapbox");
            }
            catch
            {
            }
        }
    }

