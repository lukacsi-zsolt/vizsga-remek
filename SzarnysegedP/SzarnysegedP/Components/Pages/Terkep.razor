@page "/Terkep"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@inject IJSRuntime JS
@inject IConfiguration Config
@inject IHttpClientFactory HttpClientFactory

<style>
    .terkepcard {
        background: white;
        border: 1px solid rgba(92,74,50,0.12);
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(92,74,50,0.08);
        margin-bottom: 24px;
    }

    .terkepcard .card-body {
        padding: 24px;
    }

    .terkepcard .card-body h4 {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        color: #3a2e1e;
        margin-bottom: 16px;
        font-weight: 700;
    }

    #map {
        width: 100%;
        height: 500px;
        border-radius: 4px;
        overflow: hidden;
    }

    .terkepcard table {
        width: 100%;
        border-collapse: collapse;
    }

    .terkepcard .table-dark th {
        background: #2d5a3d;
        color: white;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.5px;
        padding: 12px 16px;
        border: none;
    }

    .terkepcard .table-striped tbody tr:nth-child(odd) {
        background: #f5f0e8;
    }

    .terkepcard .table-striped tbody tr:nth-child(even) {
        background: white;
    }

    .terkepcard .table-striped tbody td {
        padding: 11px 16px;
        font-size: 14px;
        color: #3a2e1e;
        border: none;
        border-bottom: 1px solid rgba(92,74,50,0.07);
    }

    .spot-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .spot-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 16px;
    }

    .spot-field label {
        font-size: 12px;
        font-weight: 700;
        color: #5c4a32;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .spot-field input,
    .spot-field textarea {
        width: 100%;
        border: 1px solid rgba(92,74,50,0.18);
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 14px;
        color: #2e2416;
        background: #fff;
    }

    .spot-field textarea {
        min-height: 120px;
        resize: vertical;
    }

    .spot-form-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .spot-info-line {
        color: #7a6e5f;
        font-size: 14px;
        margin-bottom: 16px;
    }

    .spot-message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fff4e8;
        border: 1px solid rgba(122,110,95,0.22);
        color: #5c4a32;
        font-size: 13px;
    }

    .spot-add-btn {
        margin-bottom: 16px;
    }

    .spot-cancel-btn {
        background: transparent;
        border: 1px solid rgba(92,74,50,0.22);
        color: #5c4a32;
        padding: 13px 24px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

<PageTitle>Térkép</PageTitle>

<div class="card mb-4 terkepcard">
    <div class="card-body">
        <h4>Spotok térképen</h4>

        <button type="button" class="btn-primary-custom spot-add-btn" @onclick="ToggleCreateForm">
            @(showCreateForm ? "Űrlap bezárása" : "Új spot hozzáadása")
        </button>

        <div id="map" class="mt-3"></div>
    </div>
</div>

@if (showCreateForm)
{
    <div class="card mb-4 terkepcard">
        <div class="card-body">
            <h4>Új spot hozzáadása</h4>

            @if (!string.IsNullOrWhiteSpace(formMessage))
            {
                <div class="spot-message">@formMessage</div>
            }

            <p class="spot-info-line">
                Kattints a térképre, vagy add meg kézzel a koordinátákat.
            </p>

            <div class="spot-form-grid">
                <div class="spot-field">
                    <label>Név</label>
                    <input @bind="ujSpot.Nev" placeholder="pl. Dobogókő" />
                </div>

                <div class="spot-field">
                    <label>Ország</label>
                    <input @bind="ujSpot.Orszag" placeholder="pl. Magyarország" />
                </div>

                <div class="spot-field">
                    <label>Megye / régió</label>
                    <input @bind="ujSpot.Megye" placeholder="pl. Pest" />
                </div>

                <div class="spot-field">
                    <label>Magasság</label>
                    <input type="number" @bind="ujSpot.Magassag" placeholder="pl. 699" />
                </div>

                <div class="spot-field">
                    <label>Szélesség (Lat)</label>
                    <input type="number" step="any" @bind="ujSpot.Lat" placeholder="pl. 47.7000" />
                </div>

                <div class="spot-field">
                    <label>Hosszúság (Lon)</label>
                    <input type="number" step="any" @bind="ujSpot.Lon" placeholder="pl. 18.9000" />
                </div>
            </div>

            <div class="spot-field">
                <label>Leírás</label>
                <textarea @bind="ujSpot.HelyLeiras" placeholder="Írj pár mondatot a spotról..."></textarea>
            </div>

            <div class="spot-field">
                <label>Szabályok</label>
                <textarea @bind="ujSpot.Szabalyok" placeholder="Speciális szabályok, megjegyzések..."></textarea>
            </div>

            <div class="spot-form-actions">
                <button type="button"
                        class="btn-primary-custom"
                        @onclick="CreateSpot"
                        disabled="@isSavingSpot">
                    @(isSavingSpot ? "Mentés..." : "Spot mentése")
                </button>

                <button type="button"
                        class="spot-cancel-btn"
                        @onclick="ResetSpotForm">
                    Törlés / újrakezdés
                </button>
            </div>
        </div>
    </div>
}

<div class="card terkepcard">
    <div class="card-body">
        <h4>Elérhető spotok</h4>
        <table class="table table-striped mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Név</th>
                    <th>Ország</th>
                    <th>Magasság</th>
                    <th>Szél</th>
                </tr>
            </thead>
            <tbody id="spot-list"></tbody>
        </table>
    </div>
</div>



@code {
    [SupplyParameterFromQuery(Name = "spot")]
    public string? SpotSlug { get; set; }

    private bool _initialized;
    private bool showCreateForm;
    private bool isSavingSpot;
    private string formMessage = "";

    private UjSpotModel ujSpot = new();
    private DotNetObjectReference<Terkep>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        var apiKey = Config["ApiTokens:MapboxKey"];
        var apiBaseUrl = Config["ApiBaseUrl"];

        _objRef = DotNetObjectReference.Create(this);

        const int maxAttempts = 20;
        const int delayMs = 250;

        for (int i = 0; i < maxAttempts; i++)
        {
            try
            {
                await JS.InvokeVoidAsync("setMapboxConfig", apiKey, SpotSlug, apiBaseUrl);
                await JS.InvokeVoidAsync("setMapboxDotNetRef", _objRef);
                await JS.InvokeVoidAsync("initMapbox", "map");

                _initialized = true;
                break;
            }
            catch
            {
                await Task.Delay(delayMs);
            }
        }

        StateHasChanged();
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        formMessage = "";
    }

    [JSInvokable]
    public Task HandleMapClick(double lat, double lon)
    {
        ujSpot.Lat = lat;
        ujSpot.Lon = lon;
        showCreateForm = true;
        formMessage = $"Koordináták kiválasztva: {lat:F6}, {lon:F6}";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CreateSpot()
    {
        if (isSavingSpot)
            return;

        formMessage = "";

        if (string.IsNullOrWhiteSpace(ujSpot.Nev))
        {
            formMessage = "A spot neve kötelező.";
            return;
        }

        if (ujSpot.Lat == null || ujSpot.Lon == null)
        {
            formMessage = "A koordináták kötelezőek.";
            return;
        }

        isSavingSpot = true;

        try
        {
            var apiClient = HttpClientFactory.CreateClient();
            apiClient.BaseAddress = new Uri(Config["ApiBaseUrl"]!);

            var response = await apiClient.PostAsJsonAsync("api/spotok", ujSpot);

            if (response.IsSuccessStatusCode)
            {
                formMessage = "A spot sikeresen létrejött.";
                ResetSpotFormValues();
                await JS.InvokeVoidAsync("reloadMapboxSpots");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                formMessage = string.IsNullOrWhiteSpace(errorText)
                    ? "A spot mentése nem sikerült."
                    : $"A spot mentése nem sikerült: {errorText}";
            }
        }
        catch (Exception ex)
        {
            formMessage = $"Hiba történt a mentés közben: {ex.Message}";
        }
        finally
        {
            isSavingSpot = false;
            StateHasChanged();
        }
    }

    private void ResetSpotForm()
    {
        ResetSpotFormValues();
        formMessage = "";
    }

    private void ResetSpotFormValues()
    {
        ujSpot = new UjSpotModel();
    }

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
        await Task.CompletedTask;
    }

    private class UjSpotModel
    {
        public string? Nev { get; set; }
        public string? Orszag { get; set; }
        public string? Megye { get; set; }
        public string? HelyLeiras { get; set; }
        public int? Magassag { get; set; }
        public string? Szabalyok { get; set; }
        public double? Lat { get; set; }
        public double? Lon { get; set; }
    }
}