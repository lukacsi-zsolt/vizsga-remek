@page "/Terkep"
@inject IJSRuntime JS
@inject IConfiguration Config
<style>
    /* ====== TERKEP OLDAL ====== */
    .terkepcard {
        background: white;
        border: 1px solid rgba(92,74,50,0.12);
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(92,74,50,0.08);
        margin-bottom: 24px;
    }

    .terkepcard .card-body {
        padding: 24px;
    }

    .terkepcard .card-body h4 {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        color: #3a2e1e;
        margin-bottom: 16px;
        font-weight: 700;
    }

    #map {
        width: 100%;
        height: 500px;
        border-radius: 4px;
        overflow: hidden;
    }

    /* ====== TABLAZAT ====== */
    .terkepcard table {
        width: 100%;
        border-collapse: collapse;
    }

    .terkepcard .table-dark th {
        background: #2d5a3d;
        color: white;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.5px;
        padding: 12px 16px;
        border: none;
    }

    .terkepcard .table-striped tbody tr:nth-child(odd) {
        background: #f5f0e8;
    }

    .terkepcard .table-striped tbody tr:nth-child(even) {
        background: white;
    }

    .terkepcard .table-striped tbody td {
        padding: 11px 16px;
        font-size: 14px;
        color: #3a2e1e;
        border: none;
        border-bottom: 1px solid rgba(92,74,50,0.07);
    }
</style>

<PageTitle>Térkép</PageTitle>

<div class="card mb-4 terkepcard">
    <div class="card-body">
        <h4>Spotok térképen</h4>
        <div id="map" class="mt-3"></div>
    </div>
</div>

<div class="card terkepcard">
    <div class="card-body">
        <h4>Elérhető spotok</h4>
        <table class="table table-striped mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Név</th>
                    <th>Ország</th>
                    <th>Magasság</th>
                    <th>Szél</th>
                </tr>
            </thead>
            <tbody id="spot-list"></tbody>
        </table>
    </div>
</div>
<script src="/js/terkep.js"></script>

@code {
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var apiKey = Config["ApiTokens:MapboxKey"];
            await JS.InvokeVoidAsync("eval", $"window.apiKey = '{apiKey}'");
        }

        if (_initialized)
        {
            return;
        }

        const int maxAttempts = 8;
        const int delayMs = 400;

        for (int attempt = 1; attempt <= maxAttempts && !_initialized; attempt++)
        {
            try
            {
                await JS.InvokeVoidAsync("console.log", $"Terkep: attempt {attempt} to call initMapbox");

                await JS.InvokeVoidAsync("initMapbox", "map");

                _initialized = true;
                await JS.InvokeVoidAsync("console.log", "Terkep: initMapbox succeeded");
                break;
            }
            catch (JSException jsEx)
            {
                await JS.InvokeVoidAsync("console.warn", $"Terkep: initMapbox attempt {attempt} failed: {jsEx.Message}");
                if (attempt < maxAttempts)
                {
                    await Task.Delay(delayMs);
                }
            }
        }

        if (!_initialized)
        {
            await JS.InvokeVoidAsync("console.error", "Terkep: failed to call initMapbox after retries. Use manual init or check console/network.");
        }
    }

    private async Task ManualInit()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", "ManualInit button clicked - calling initMapbox");
            await JS.InvokeVoidAsync("initMapbox", "map");
            await JS.InvokeVoidAsync("console.log", "Manual initMapbox call completed");
            _initialized = true;
        }
        catch (JSException jsEx)
        {
            await JS.InvokeVoidAsync("console.error", "Manual initMapbox failed:", jsEx.Message);
        }
    }
}