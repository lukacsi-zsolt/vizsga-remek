@page "/Hirek"
@* @inject HirService HirService *@
@inject NavigationManager Nav
<PageTitle>Hírek</PageTitle>
<style>
    #hirek-container {
        max-width: 900px;
        margin: 50px auto;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .hir-kartya {
        display: flex;
        align-items: center;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .hir-kartya:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        }

        .hir-kartya img {
            width: 250px;
            height: 180px;
            object-fit: cover;
        }

    .hir-tartalom {
        padding: 25px;
        flex: 1;
    }

        .hir-tartalom h3 {
            margin-bottom: 15px;
            color: #1b4332;
        }

        .hir-tartalom p {
            color: #555;
            margin-bottom: 15px;
        }

    .tovabb {
        color: #2d6a4f;
        font-weight: bold;
    }
</style>

<section id="hirek-container">

    <div class="hir-kartya" onclick="location.href='hir1.html'">
        <img src="images/hir1.jpg" alt="Hír kép">
        <div class="hir-tartalom">
            <h3>Új siklóernyős verseny Dobogókőn</h3>
            <p>Idén nyáron ismét megrendezésre kerül a népszerű hegyi verseny...</p>
            <span class="tovabb">Tovább olvasom →</span>
        </div>
    </div>

    <div class="hir-kartya" onclick="location.href='hir2.html'">
        <img src="images/hir2.jpg" alt="Hír kép">
        <div class="hir-tartalom">
            <h3>Új felszerelések érkeztek</h3>
            <p>Megérkezett a legújabb generációs beülő és ernyő...</p>
            <span class="tovabb">Tovább olvasom →</span>
        </div>
    </div>

</section>