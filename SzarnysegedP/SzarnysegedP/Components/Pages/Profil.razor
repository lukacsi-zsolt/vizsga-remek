@page "/profil"
@page "/profil/{FelhasznaloNev}"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using SzarnysegedShared.DTOs.FelhasznaloDTOs
@using SzarnysegedShared.DTOs.ForumDTOs
@inject SzarnysegedP.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>@(profil?.TeljesNev ?? "Profil") – Szárnysegéd</PageTitle>

@* ===== FELTÉTELES RENDERELÉS ===== *@
@if (isLoading)
{
    <div style="padding: 40px; text-align: center;">
        <p>Profil betöltése...</p>
    </div>
}
else if (profil == null)
{
    <div style="padding: 40px; text-align: center;">
        <p>A felhasználó nem található.</p>
    </div>
}
else
{
    @* ===== BORÍTÓKÉP ===== *@
    <div class="profil-cover" style="background-image: url('@GetCoverUrl()')">
        <div class="profil-cover-overlay"></div>
    </div>

    @* ===== PROFIL FEJLÉC (avatar + név + gombok) ===== *@
    <div class="profil-wrapper">
        <div class="profil-fejlec">
            <div class="profil-avatar-wrap">
                @if (!string.IsNullOrWhiteSpace(profil.AvatarUrl))
                {
                    <img class="profil-avatar" src="@profil.AvatarUrl" alt="@profil.TeljesNev" />
                }
                else
                {
                    <div class="profil-avatar profil-avatar-monogram">
                        @GetMonogram()
                    </div>
                }
            </div>

            <div class="profil-info">
                <h1 class="profil-nev">@profil.TeljesNev</h1>
                @* A felhasználónév elé @ jelet teszünk *@
                <p class="profil-handle">
                    @("@"+profil.FelhasznaloNev)
                    @if (profil.SzuletesiDatum.HasValue)
                    {
                        <span> · Születési dátum: @profil.SzuletesiDatum.Value.ToString("yyyy. MM. dd.")</span>
                    }
                </p>

                @* Statisztika badge-ek: posztok, kommentek, követők, követettek száma *@
                <div class="profil-badge-sor">
                    <span class="profil-badge">@(stats?.Posztok ?? 0) poszt</span>
                    <span class="profil-badge profil-badge-outline">@(stats?.Kommentek ?? 0) komment</span>
                    <span class="profil-badge profil-badge-outline">@(stats?.Kovetok ?? 0) követő</span>
                    <span class="profil-badge profil-badge-outline">@(stats?.Kovetettek ?? 0) követett</span>
                </div>
            </div>

            @* ===== AKCIÓ GOMBOK ===== *@
            <div class="profil-akciok">
                @if (sajatProfil)
                {
                    <a href="/profil/szerkesztes" class="btn-primary-custom">Profil szerkesztése</a>
                }
                else if (aktualisUser != null && profil.FelhasznaloID != aktualisUser.FelhasznaloID)
                {
                    <button class="btn-primary-custom" @onclick="KovetesValtas">
                        @(koveti ? "Követés leállítása" : "Követés")
                    </button>
                }
            </div>
        </div>

        @* ===== FŐ TARTALOM: SIDEBAR + POSZTOK ===== *@
        <div class="profil-main">
            @* ===== BAL OLDALI SIDEBAR ===== *@
            <aside class="profil-sidebar">
                @* --- Rólam kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Rólam</h3>
                    <p class="profil-bio">
                        @(string.IsNullOrWhiteSpace(profil.Bio) ? "A felhasználó még nem adott meg bemutatkozást." : profil.Bio)
                    </p>

                    <div class="profil-reszletek">
                        @* Csak akkor jelenítjük meg a mezőt, ha ki van töltve *@
                        @if (!string.IsNullOrWhiteSpace(profil.Helyszin))
                        {
                            <div class="profil-reszlet-sor">
                                <svg class="profil-ikon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M8 9A3 3 0 1 0 8 3a3 3 0 0 0 0 6z" />
                                    <path d="M8 9c-3.3 0-6 1.8-6 4h12c0-2.2-2.7-4-6-4z" />
                                </svg>
                                <span>@profil.Helyszin</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(profil.Klub))
                        {
                            <div class="profil-reszlet-sor">
                                <svg class="profil-ikon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M2 12V6l6-4 6 4v6l-6 3-6-3z" />
                                </svg>
                                <span>@profil.Klub</span>
                            </div>
                        }
                        @* Email CSAK a saját profilon látszik (adatvédelem) *@
                        @if (sajatProfil && !string.IsNullOrWhiteSpace(profil.Email))
                        {
                            <div class="profil-reszlet-sor">
                                <svg class="profil-ikon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M2 4h12v8H2z" />
                                    <path d="M2 4l6 4 6-4" />
                                </svg>
                                <span>@profil.Email</span>
                            </div>
                        }
                    </div>
                </div>

                @* --- Statisztikák kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Statisztikák</h3>

                    <div class="profil-stat-sor">
                        <div class="profil-stat">
                            <div class="profil-stat-szam">@(stats?.Posztok ?? 0)</div>
                            <div class="profil-stat-cimke">Poszt</div>
                        </div>
                        <div class="profil-stat">
                            <div class="profil-stat-szam">@(stats?.Kommentek ?? 0)</div>
                            <div class="profil-stat-cimke">Komment</div>
                        </div>
                        <div class="profil-stat">
                            <div class="profil-stat-szam">@(stats?.Kovetok ?? 0)</div>
                            <div class="profil-stat-cimke">Követő</div>
                        </div>
                    </div>

                    @* Progress bar a követett felhasználók számához *@
                    <div class="profil-szint-wrap">
                        <div class="profil-szint-sor">
                            <span>Követett felhasználók</span>
                            <span>@(stats?.Kovetettek ?? 0)</span>
                        </div>
                        <div class="profil-szint-sav">
                            <div class="profil-szint-tolt" style="width:@GetFollowProgress()%"></div>
                        </div>
                    </div>
                </div>

                @* --- Követettek kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Követi</h3>

                    @if (kovetettek.Count == 0)
                    {
                        <p class="profil-bio">Még nem követ senkit.</p>
                    }
                    else
                    {
                        @foreach (var user in kovetettek)
                        {
                            <div class="profil-spot">
                                <div class="profil-spot-ikon">
                                    @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                    {
                                        <img src="@user.AvatarUrl" alt="@user.TeljesNev" style="width:40px;height:36px;border-radius:6px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="color:white;font-weight:700;">@GetMonogram(user.TeljesNev)</span>
                                    }
                                </div>
                                <div>
                                    <p class="profil-spot-nev">@user.TeljesNev</p>
                                    <p class="profil-spot-helyszin">
                                        <a href="/profil/@user.FelhasznaloNev">@("@"+user.FelhasznaloNev)</a>
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* --- Követők kártya --- *@
                <div class="profil-card">
                    <h3 class="profil-card-cim">Követők</h3>

                    @if (kovetok.Count == 0)
                    {
                        <p class="profil-bio">Még nincsenek követői.</p>
                    }
                    else
                    {
                        @foreach (var user in kovetok)
                        {
                            <div class="profil-spot">
                                <div class="profil-spot-ikon">
                                    @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                    {
                                        <img src="@user.AvatarUrl" alt="@user.TeljesNev" style="width:40px;height:36px;border-radius:6px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="color:white;font-weight:700;">@GetMonogram(user.TeljesNev)</span>
                                    }
                                </div>
                                <div>
                                    <p class="profil-spot-nev">@user.TeljesNev</p>
                                    <p class="profil-spot-helyszin">
                                        <a href="/profil/@user.FelhasznaloNev">@("@"+user.FelhasznaloNev)</a>
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </aside>
            
            @* ===== JOBB OLDALI FŐ TARTALOM ===== *@
            <section class="profil-tartalom">
                <div class="profil-card" style="padding: 0;">
                    <div class="profil-tabok">
                        <button class="profil-tab @(aktivTab == "posztok" ? "aktiv" : "")"
                                @onclick='() => aktivTab = "posztok"'>
                            Bejegyzések
                        </button>
                        <button class="profil-tab @(aktivTab == "kedveltek" ? "aktiv" : "")"
                                @onclick='() => aktivTab = "kedveltek"'>
                            Információ
                        </button>
                    </div>
                </div>

                @* ===== BEJEGYZÉSEK TAB ===== *@
                @if (aktivTab == "posztok")
                {
                    @if (posztok.Count == 0)
                    {
                        <div class="profil-card">
                            <p style="color: var(--brown-light); font-size: 14px; text-align: center; padding: 40px 0;">
                                Ennek a felhasználónak még nincs fórumbejegyzése.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="profil-posztok-racs">
                            @foreach (var poszt in posztok)
                            {
                                <div class="profil-poszt-kartya" @onclick='() => OpenPost(poszt.BejegyzesID)' style="cursor:pointer;">
                                    @if (!string.IsNullOrWhiteSpace(poszt.KepUrl))
                                    {
                                        <div class="profil-poszt-kep" style="background-image: url('@poszt.KepUrl')"></div>
                                    }

                                    <div class="profil-poszt-body">
                                        <p class="profil-poszt-cim">@poszt.Cim</p>
                                        <p class="profil-poszt-meta">
                                            @poszt.Letrehozva.ToString("yyyy. MM. dd.")
                                            @if (!string.IsNullOrWhiteSpace(poszt.SpotNev))
                                            {
                                                <span> · @poszt.SpotNev</span>
                                            }
                                        </p>
                                        <p class="profil-poszt-szoveg">@Shorten(poszt.Tartalom, 140)</p>

                                        <div class="profil-poszt-footer">
                                            <span class="profil-akció">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <path d="M2 8c0-3.3 2.7-6 6-6s6 2.7 6 6-2.7 6-6 6H2l2-2.5" />
                                                </svg>
                                                @poszt.KommentekSzama hozzászólás
                                            </span>

                                            <span class="profil-akció">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <circle cx="8" cy="8" r="5.5" />
                                                </svg>
                                                @("@"+poszt.FelhasznaloNev)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                @* ===== INFORMÁCIÓ TAB ===== *@
                else if (aktivTab == "kedveltek")
                {
                    <div class="profil-card">
                        <div class="info-section" style="margin-bottom:0;padding-bottom:0;border-bottom:none;">
                            <h2>Felhasználói adatok</h2>
                            <p><strong>Teljes név:</strong> @profil.TeljesNev</p>
                            <p><strong>Felhasználónév:</strong> @("@"+profil.FelhasznaloNev)</p>
                            <p><strong>Helyszín:</strong> @(string.IsNullOrWhiteSpace(profil.Helyszin) ? "Nincs megadva" : profil.Helyszin)</p>
                            <p><strong>Klub:</strong> @(string.IsNullOrWhiteSpace(profil.Klub) ? "Nincs megadva" : profil.Klub)</p>
                            <p><strong>Bemutatkozás:</strong> @(string.IsNullOrWhiteSpace(profil.Bio) ? "Nincs megadva" : profil.Bio)</p>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    // ===== ROUTE PARAMÉTER =====
    [Parameter] public string? FelhasznaloNev { get; set; }

    // ===== ÁLLAPOTVÁLTOZÓK =====
    private bool isLoading = true;
    private string aktivTab = "posztok";

    private FelhasznaloDTO? profil;
    private FelhasznaloDTO? aktualisUser;

    private ProfilStats stats = new();
    private List<BejegyzesListaDto> posztok = new();
    private List<FelhasznaloDTO> kovetok = new();
    private List<FelhasznaloDTO> kovetettek = new();

    private bool koveti;

    // ===== SZÁMÍTOTT PROPERTY =====
    private bool sajatProfil =>
        aktualisUser != null &&
        profil != null &&
        aktualisUser.FelhasznaloID == profil.FelhasznaloID;

    // ===== ÉLETCIKLUS: ELSŐ RENDERELÉS UTÁN =====
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        aktualisUser = await AuthService.GetCurrentUser();
        await LoadProfileAsync();
        isLoading = false;
        StateHasChanged();
    }

    // ===== ÉLETCIKLUS: PARAMÉTER VÁLTOZÁSKOR =====
    protected override async Task OnParametersSetAsync()
    {
        if (!isLoading && aktualisUser != null)
        {
            await LoadProfileAsync();
            StateHasChanged();
        }
    }

    // ===== PROFIL ADATOK BETÖLTÉSE =====
    private async Task LoadProfileAsync()
    {
        profil = null;
        stats = new ProfilStats();
        posztok = new();
        kovetok = new();
        kovetettek = new();
        koveti = false;

        try
        {
            if (string.IsNullOrWhiteSpace(FelhasznaloNev))
            {
                profil = aktualisUser;
            }
            else
            {
                profil = await Http.GetFromJsonAsync<FelhasznaloDTO>($"api/felhasznalok/nev/{FelhasznaloNev}");
            }

            if (profil == null)
                return;
        }
        catch
        {
            profil = null;
            return;
        }

        try
        {
            stats = await Http.GetFromJsonAsync<ProfilStats>($"api/felhasznalok/{profil.FelhasznaloID}/statisztika") ?? new ProfilStats();
        }
        catch
        {
            stats = new ProfilStats();
        }

        try
        {
            posztok = await Http.GetFromJsonAsync<List<BejegyzesListaDto>>($"api/felhasznalok/{profil.FelhasznaloID}/posztok") ?? new();
        }
        catch
        {
            posztok = new();
        }

        try
        {
            kovetok = await Http.GetFromJsonAsync<List<FelhasznaloDTO>>($"api/felhasznalok/{profil.FelhasznaloID}/kovetok") ?? new();
        }
        catch
        {
            kovetok = new();
        }

        try
        {
            kovetettek = await Http.GetFromJsonAsync<List<FelhasznaloDTO>>($"api/felhasznalok/{profil.FelhasznaloID}/kovetettek") ?? new();
        }
        catch
        {
            kovetettek = new();
        }

        if (aktualisUser != null && !sajatProfil)
        {
            try
            {
                await AuthService.SetAuthorizationHeader();
                var result = await Http.GetFromJsonAsync<KovetesAllapotDto>($"api/kovetesek/allapot/{profil.FelhasznaloID}");
                koveti = result?.koveti ?? false;
            }
            catch
            {
                koveti = false;
            }
        }
    }

    // ===== KÖVETÉS / KIKÖVETÉS (TOGGLE) =====
    private async Task KovetesValtas()
    {
        if (profil == null || aktualisUser == null || sajatProfil)
            return;

        await AuthService.SetAuthorizationHeader();
        var response = await Http.PostAsync($"api/kovetesek/{profil.FelhasznaloID}", null);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<KovetesAllapotDto>();
            koveti = result?.koveti ?? false;

            stats = await Http.GetFromJsonAsync<ProfilStats>($"api/felhasznalok/{profil.FelhasznaloID}/statisztika") ?? new ProfilStats();
            kovetok = await Http.GetFromJsonAsync<List<FelhasznaloDTO>>($"api/felhasznalok/{profil.FelhasznaloID}/kovetok") ?? new();
        }
    }

    // ===== NAVIGÁCIÓ BEJEGYZÉSRE =====
    private void OpenPost(int postId)
    {
        Navigation.NavigateTo($"/forum/bejegyzes/{postId}");
    }

    // ===== SEGÉDMETÓDUSOK =====
    private string GetCoverUrl()
    {
        if (profil == null || string.IsNullOrWhiteSpace(profil.CoverUrl))
            return "/images/kodos.jpg";

        return profil.CoverUrl;
    }

    // Monogram: a név első betűiből készít rövidítést
    private string GetMonogram()
    {
        return GetMonogram(profil?.TeljesNev);
    }

    private string GetMonogram(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "F";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return parts[0][0].ToString().ToUpper();
    }

    // Szöveg rövidítése megadott maximális hosszra
    private string Shorten(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var cleaned = text.Replace("\r", " ").Replace("\n", " ").Trim();
        if (cleaned.Length <= max)
            return cleaned;

        return cleaned[..max].Trim() + "...";
    }

    // Követési progress bar százalék kiszámítása
    private int GetFollowProgress()
    {
        var value = stats.Kovetettek * 10;
        return Math.Clamp(value, 0, 100);
    }

    // ===== BELSŐ SEGÉDOSZTÁLYOK =====
    // Ezek a JSON deszerializáláshoz kellenek (az API válaszának fogadásához)
    // Profil statisztikák DTO-ja
    private class ProfilStats
    {
        public int Posztok { get; set; }
        public int Kommentek { get; set; }
        public int Kovetok { get; set; }
        public int Kovetettek { get; set; }
    }

    // Követési állapot DTO-ja
    private class KovetesAllapotDto
    {
        public bool koveti { get; set; }
    }
}