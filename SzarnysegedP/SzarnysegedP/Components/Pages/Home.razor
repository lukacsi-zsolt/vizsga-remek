@page "/"

<PageTitle>Főoldal</PageTitle>

<!-- ====== HERO ====== -->
<section class="hero">
    <div class="hero-content">
        <h1>Repülési feltételek<br />egy helyen</h1>
        <p>Valós idejű időjárás, starthelyek és repülési döntéstámogatás<br />siklóernyősöknek és deltaesárkány-pilótáknak.</p>
        <div class="hero-buttons">
            <a href="/Terkep" class="btn-primary-custom">Hol repüljek ma?</a>
            <a href="/Info" class="btn-secondary-custom">Kezdőknek</a>
        </div>
    </div>
</section>

<!-- ====== WHY US ====== -->
<section class="why-us">
    <div class="container-xl w-100">
        <div class="text-center mb-5">
            <h2>Miért Szárnysegéd?</h2>
            <span class="why-subtitle">Inkább kaland, mint munka</span>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="why-item">
                    <i class="bi bi-broadcast-pin why-icon"></i>
                    <h4>Naprakész információk</h4>
                    <p>Mindig friss adatok a biztonságos repüléshez – valós idejű időjárás és láthatósági adatok.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="why-item">
                    <i class="bi bi-geo-alt why-icon"></i>
                    <h4>Megbízható helyszínek</h4>
                    <p>Bevált start- és leszállóhelyek egy helyen, szűrési lehetőséggel és térképes megjelenítéssel.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="why-item">
                    <i class="bi bi-wind why-icon"></i>
                    <h4>Kezdőknek és haladóknak</h4>
                    <p>Akár most indulsz, akár már tapasztalt pilóta vagy – minden szinthez megtalálod a megfelelő infót.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ====== IDŐJÁRÁS ====== -->
<section class="flight-status">
    <div class="container-xl w-100">
        <div class="text-center">
            <h2>Mai repülési feltételek</h2>
            <span class="section-sub">Budapest és környéke – élő adatok</span>
        </div>
        <div class="weather-box">
            <div class="row g-0 align-items-center justify-content-center">
                <div class="col-6 col-sm-3 weather-item">
                    <div class="weather-val" id="weather-temp">–</div>
                    <div class="weather-unit">Hőmérséklet</div>
                </div>
                <div class="col-auto d-none d-sm-block weather-divider mx-3" style="height:60px;"></div>
                <div class="col-6 col-sm-3 weather-item">
                    <div class="weather-val" id="weather-wind">–</div>
                    <div class="weather-unit">Szél</div>
                </div>
                <div class="col-auto d-none d-sm-block weather-divider mx-3" style="height:60px;"></div>
                <div class="col-6 col-sm-3 weather-item">
                    <div class="weather-val" id="weather-visibility">–</div>
                    <div class="weather-unit">Látótávolság</div>
                </div>
                <div class="col-auto d-none d-sm-block weather-divider mx-3" style="height:60px;"></div>
                <div class="col-6 col-sm-3 weather-item">
                    <div class="weather-val" id="weather-sky">–</div>
                    <div class="weather-unit">Égbolt</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ====== KÁRTYÁK ====== -->
<section class="home-features">
    <div class="container-xl w-100">
        <div class="text-center">
            <h2>Mit találsz az oldalon?</h2>
            <span class="section-sub">Gyors döntés a repüléshez – minden egy helyen.</span>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/Hirek" class="home-card">
                    <div class="home-card-image">
                        <img src="/images/nap.png" alt="Hírek" />
                    </div>
                    <div class="home-card-title">Hírek</div>
                    <div class="home-card-text">Napi hírek és érdekességek a siklóernyős világ eseményeiről.</div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/Terkep" class="home-card">
                    <div class="home-card-image">
                        <img src="/images/kep.jpg" alt="Térkép" />
                    </div>
                    <div class="home-card-title">Térkép</div>
                    <div class="home-card-text">Megbízható start- és leszállóhelyek interaktív térképen.</div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/Info" class="home-card">
                    <div class="home-card-image">
                        <img src="/images/kep2.jpg" alt="Infó" />
                    </div>
                    <div class="home-card-title">Információ</div>
                    <div class="home-card-text">Szabályok, eszközök és tanácsok kezdőknek és haladóknak.</div>
                </a>
            </div>
        </div>
    </div>
</section>