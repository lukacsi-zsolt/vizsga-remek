@page "/"
<style>
    /* ====== DOBOZOK FŐOLDALON ====== */
    #home-cards {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 60px;
        margin-bottom: 50px;
        width: 100vw; /* javítva: 100 vw -> 100vw */
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        flex-wrap: wrap; /* ha kisebb képernyő */
    }

        #home-cards .home-card {
            width: 250px;
            border: 1px solid lightgray;
            text-decoration: none;
            color: black;
        }

        #home-cards .home-card-title {
            height: auto;
            font-size: 16px;
            font-weight: bold;
            margin: 20px auto;
            text-align: center;
        }

        #home-cards .home-card-image {
            height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 1px solid darkgray;
        }

        #home-cards .home-card-text {
            padding: 15px;
            text-align: center;
        }

        #home-cards .home-card:hover {
            background-color: #f2f2f2;
            transform: scale(1.05);
            transition: 0.3s;
        }

        #home-cards .home-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

<PageTitle>Főoldal</PageTitle>
<div class="why-us">
    <div class="why-container">
        <h2>Miért Szárnysegéd?</h2>
        <p class="why-subtitle">Inkább kaland, mint munka</p>

        <div class="why-features">
            <div class="why-item">
                <h4>✔️ Naprakész információk</h4>
                <p>Mindig friss adatok a biztonságos repüléshez.</p>
            </div>

            <div class="why-item">
                <h4>✔️ Megbízható helyszínek</h4>
                <p>Bevált start- és leszállóhelyek egy helyen.</p>
            </div>

            <div class="why-item">
                <h4>✔️ Kezdőknek és haladóknak</h4>
                <p>Akár most indulsz, akár már tapasztalt pilóta vagy.</p>
            </div>
        </div>
    </div>
</div>

<script src="//unpkg.com/d3@7.8.5/dist/d3.min.js"></script>
<div class="weather-wrapper">
    <div id="openweathermap-widget-22"></div>
    <script type="text/javascript">
        window.myWidgetParam ? window.myWidgetParam : window.myWidgetParam = [];
        window.myWidgetParam.push({
          id: 22,
          cityid: '3054643',
          appid: '3caa2c69a27fcb1aff1c39f3d19f82c8',
          units: 'metric',
          containerid: 'openweathermap-widget-22',
        });
        (function() {
          var script = document.createElement('script');
          script.async = true;
          script.charset = "utf-8";
          script.src = "//openweathermap.org/themes/openweathermap/assets/vendor/owm/js/weather-widget-generator-2.0.js";
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(script, s);
        })();
    </script>
</div>

<div id="home-cards" class="cards">
  
  <a href="/Elerhetosegek" class="home-card card">
    <div class="home-card-title">Elérhetőség</div>
    <div class="home-card-image">
        <img src="/images/nap.png" alt="Elérhetőség">
    </div>
    <div class="home-card-text">Gyors áttekintés repülés előtt.</div>
  </a>

    <a href="/Terkep" class="home-card card">
    <div class="home-card-title">Térkép</div>
    <div class="home-card-image">
        <img src="/images/kep.jpg" alt="Térkép">
    </div>
    <div class="home-card-text">Megbízható helyszínek egy térképen.</div>
  </a>

    <a href="/Info" class="home-card card">
    <div class="home-card-title">Információ</div>
    <div class="home-card-image">
        <img src="/images/kep2.jpg" alt="Infó">
    </div>
    <div class="home-card-text">Letisztult felület, mobilbarát megjelenés.</div>
  </a>

</div>
