@inject SzarnysegedP.Services.AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer
<style>
    .nav-item {
        padding: 0 !important;
    }
</style>
@* ===== BOOTSTRAP NAVBAR ===== *@
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container-xl w-100">

        <!-- Brand / Logo – mindig látható -->
        <a class="navbar-brand" href="/">
            <img src="/images/sikloernyos.png" alt="Szárnysegéd logó" />
            <div class="brand-text">
                <span class="brand-name">Szárnysegéd</span>
                <span class="slogan">Inkább kaland, mint munka</span>
            </div>
        </a>

        <!-- Hamburger gomb mobilon -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Menü megnyitása">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Nav linkek -->
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto">
                @* Admin link: CSAK akkor jelenik meg, ha a felhasználó admin *@
                @if (isAdmin)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="admin">Admin Dashboard</NavLink>
                    </li>
                }
                @* Publikus menüpontok – mindig láthatók *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Kezdőlap</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Terkep">Térkép</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="forum">Fórum</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Hirek">Hírek</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Info">Info</NavLink>
                </li>

                @* ===== FIÓK DROPDOWN MENÜ ===== *@
                @* Bootstrap dropdown: a gomb kattintásakor megjelenik a lenyíló menü *@
                <li class="nav-item dropdown">
                    <button class="nav-link nav-link-account dropdown-toggle"
                            type="button"
                            id="userDropdownBtn"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Fiók
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownBtn">
                        @* Feltételes menüelemek a bejelentkezési állapot alapján *@
                        @if (isLoggedIn)
                        {
                            <li>
                                <a class="dropdown-item" href="/profil">Profil</a>
                            </li>
                            <li>
                                @* A kijelentkezés @onclick esemény, nem link *@
                                <button class="dropdown-item" @onclick="Logout">Kijelentkezés</button>
                            </li>
                        }
                        else
                        {
                            @* Vendég felhasználó: Bejelentkezés + Regisztráció *@
                            <li><a class="dropdown-item" href="/login">Bejelentkezés</a></li>
                            <li><a class="dropdown-item" href="/register">Regisztráció</a></li>
                        }
                    </ul>
                </li>
            </ul>
        </div>

    </div>
</nav>

@code {
    // Állapotváltozók: a menü tartalmát ezek határozzák meg
    private bool isLoggedIn;
    private bool isAdmin;

    // ===== ÉLETCIKLUS: INICIALIZÁLÁS =====
    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    // ===== ÉLETCIKLUS: ELSŐ RENDERELÉS UTÁN =====
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isAdmin = await AuthService.IsAdmin();
            isLoggedIn = await AuthService.IsLoggedIn();
            StateHasChanged();
        }
    }

    // ===== ESEMÉNYKEZELŐ: AUTENTIKÁCIÓS ÁLLAPOT VÁLTOZÁS =====
    private async void OnAuthStateChanged()
    {
        isAdmin = await AuthService.IsAdmin();
        isLoggedIn = await AuthService.IsLoggedIn();
        await InvokeAsync(StateHasChanged);
    }

    // ===== KIJELENTKEZÉS =====
    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    // ===== DISPOSE: ESEMÉNY LEIRATKOZÁS =====
    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }
}