<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Karakterkódolás: UTF-8 -->
    <meta charset="utf-8" />
    <!-- Reszponzív megjelenítés -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Alap URL: az összes relatív hivatkozás ehhez képest értendő -->
    <base href="/" />

    <!-- ===== KÜLSŐ CSS KÖNYVTÁRAK ===== -->
    <!-- Mapbox GL: interaktív térkép -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <!-- Mapbox JS: a térkép JavaScript motorja -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>


    <!-- Bootstrap 5.3.2 CSS: reszponzív rácsrendszer, gombok, kártyák, űrlapok stílusai -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons: ikonkészlet -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- ===== SAJÁT ÉS HELYI STÍLUSOK ===== -->
    <link href="/css/style.css" rel="stylesheet" />                 <!-- Egyedi CSS stílusok -->
    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css" />   <!-- Lokális Bootstrap másolat -->
    <link rel="stylesheet" href="/app.css" />                       <!-- Alkalmazás szintű stílusok -->
    <link rel="stylesheet" href="/SzarnysegedP.styles.css" />       <!-- Blazor által generált scoped CSS -->
    <link rel="icon" type="image/png" href="/favicon.png" />        <!-- Böngésző fülön megjelenő ikon -->

    <!-- OpenWeatherMap stílusok: időjárás widget -->
    <link rel="stylesheet" href="//openweathermap.org/themes/openweathermap/assets/vendor/owm/css/style.min.css">

     <!-- ===== BLAZOR HEAD OUTLET ===== -->
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <!-- ===== BLAZOR ALKALMAZÁS GYÖKERE ===== -->
    <Routes @rendermode="InteractiveServer" />

    <!-- ===== JAVASCRIPT FÁJLOK ===== -->
    <script src="/js/weather.js"></script>  <!-- időjárás widget kezelése -->
    <script src="/js/terkep.js"></script>    <!-- Mapbox térkép inicializálása és kezelése -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>     <!-- Bootstrap JS: dropdown menük, modális ablakok, tooltip-ek működéséhez -->

    <!-- ===== BLAZOR SZERVER KERETRENDSZER ===== -->
    <!-- Ez a LEGFONTOSABB script – ez hozza létre a SignalR kapcsolatot a szerver és böngésző között -->
    <!-- Enélkül a Blazor Server alkalmazás NEM működik (nincs interaktivitás) -->
    <script src="/_framework/blazor.server.js"></script>
    <!-- Chart.js: diagramok rajzolása -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Saját JS: az admin dashboard chart inicializálása -->
    <script src="/js/admin-chart.js"></script>
</body>

</html>
